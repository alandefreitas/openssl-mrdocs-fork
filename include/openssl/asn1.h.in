 * @brief Allocate an empty ASN.1 OBJECT identifier.
 * @return New ASN1_OBJECT, or NULL on allocation failure.
 */
ASN1_OBJECT *ASN1_OBJECT_new(void);
/**
 * @brief Free an ASN.1 OBJECT identifier and its contents.
