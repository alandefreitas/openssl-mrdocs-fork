    SSL_ctrl(s, SSL_CTRL_GET_PEER_SIGNATURE_NID, 0, pn)
#define SSL_get_peer_tmp_key(s, pk) \
    SSL_ctrl(s, SSL_CTRL_GET_PEER_TMP_KEY, 0, pk)
#define SSL_get_tmp_key(s, pk) \
    SSL_ctrl(s, SSL_CTRL_GET_TMP_KEY, 0, pk)
#define SSL_get0_raw_cipherlist(s, plst) \
    SSL_ctrl(s, SSL_CTRL_GET_RAW_CIPHERLIST, 0, plst)
#define SSL_get0_ec_point_formats(s, plst) \
    SSL_ctrl(s, SSL_CTRL_GET_EC_POINT_FORMATS, 0, plst)
#define SSL_CTX_set_min_proto_version(ctx, version) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, version, NULL)
#define SSL_CTX_set_max_proto_version(ctx, version) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MAX_PROTO_VERSION, version, NULL)
#define SSL_CTX_get_min_proto_version(ctx) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_GET_MIN_PROTO_VERSION, 0, NULL)
#define SSL_CTX_get_max_proto_version(ctx) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_GET_MAX_PROTO_VERSION, 0, NULL)
#define SSL_set_min_proto_version(s, version) \
    SSL_ctrl(s, SSL_CTRL_SET_MIN_PROTO_VERSION, version, NULL)
#define SSL_set_max_proto_version(s, version) \
    SSL_ctrl(s, SSL_CTRL_SET_MAX_PROTO_VERSION, version, NULL)
#define SSL_get_min_proto_version(s) \
    SSL_ctrl(s, SSL_CTRL_GET_MIN_PROTO_VERSION, 0, NULL)
#define SSL_get_max_proto_version(s) \
    SSL_ctrl(s, SSL_CTRL_GET_MAX_PROTO_VERSION, 0, NULL)

/**
 * @brief Return the name of the key-exchange group negotiated on @p s.
 * @param s SSL connection after a successful handshake (or once the group is known).
 * @return Internal NUL-terminated group name string, or NULL if none is available; do not free.
 */
/**
 * @brief Return the name of the key-exchange group negotiated on @p s.
 * @param s SSL connection after a successful handshake (or once the group is known).
 * @return Internal NUL-terminated group name string, or NULL if none is available; do not free.
 */
const char *SSL_get0_group_name(SSL *s);
/**
 * @brief Return the TLS group name registered for a group identifier on this connection.
 * @param s SSL object whose providers/group registry are consulted.
 * @param id TLS group ID as returned by APIs such as SSL_get1_groups().
 * @return NUL-terminated group name string, or NULL if no matching name is registered.
 */
const char *SSL_group_to_name(SSL *s, int id);

/* Backwards compatibility, original 1.1.0 names */
#define SSL_CTRL_GET_SERVER_TMP_KEY \
    SSL_CTRL_GET_PEER_TMP_KEY
#define SSL_get_server_tmp_key(s, pk) \
    SSL_get_peer_tmp_key(s, pk)

/**
 * @brief Set ephemeral DH parameters for a connection, transferring ownership of @p dhpkey.
 * @param s SSL connection that will use the parameters for DHE key exchange.
 * @param dhpkey EVP_PKEY holding DH parameters; ownership transfers to @p s on success.
 * @return 1 on success, or 0 on failure.
 */
int SSL_set0_tmp_dh_pkey(SSL *s, EVP_PKEY *dhpkey);
/**
 * @brief Set ephemeral DH parameters for a context, transferring ownership of @p dhpkey.
 * @param ctx SSL context whose new connections inherit the parameters for DHE.
 * @param dhpkey EVP_PKEY holding DH parameters; ownership transfers to @p ctx on success.
 * @return 1 on success, or 0 on failure.
 */
int SSL_CTX_set0_tmp_dh_pkey(SSL_CTX *ctx, EVP_PKEY *dhpkey);

/*
 * The following symbol names are old and obsolete. They are kept
 * for compatibility reasons only and should not be used anymore.
 */
#define SSL_CTRL_GET_CURVES SSL_CTRL_GET_GROUPS
#define SSL_CTRL_SET_CURVES SSL_CTRL_SET_GROUPS
#define SSL_CTRL_SET_CURVES_LIST SSL_CTRL_SET_GROUPS_LIST
#define SSL_CTRL_GET_SHARED_CURVE SSL_CTRL_GET_SHARED_GROUP

#define SSL_get1_curves SSL_get1_groups
#define SSL_CTX_set1_curves SSL_CTX_set1_groups
#define SSL_CTX_set1_curves_list SSL_CTX_set1_groups_list
#define SSL_set1_curves SSL_set1_groups
#define SSL_set1_curves_list SSL_set1_groups_list
#define SSL_get_shared_curve SSL_get_shared_group

#ifndef OPENSSL_NO_DEPRECATED_1_1_0
/* Provide some compatibility macros for removed functionality. */
#define SSL_CTX_need_tmp_RSA(ctx) 0
#define SSL_CTX_set_tmp_rsa(ctx, rsa) 1
#define SSL_need_tmp_RSA(ssl) 0
#define SSL_set_tmp_rsa(ssl, rsa) 1
#define SSL_CTX_set_ecdh_auto(dummy, onoff) ((onoff) != 0)
#define SSL_set_ecdh_auto(dummy, onoff) ((onoff) != 0)
/*
 * We "pretend" to call the callback to avoid warnings about unused static
 * functions.
 */
#define SSL_CTX_set_tmp_rsa_callback(ctx, cb) \
    while (0)                                 \
    (cb)(NULL, 0, 0)
#define SSL_set_tmp_rsa_callback(ssl, cb) \
    while (0)                             \
    (cb)(NULL, 0, 0)
#endif
/**
 * @brief Return the SSL filter BIO method that wraps TLS I/O in a BIO.
 * @return Pointer to the static BIO_METHOD for SSL filter BIOs.
 */
__owur const BIO_METHOD *BIO_f_ssl(void);
/**
 * @brief Allocate an SSL filter BIO using the given context.
 * @param ctx SSL context used to create the internal SSL object.
 * @param client Non-zero for client mode; zero for server mode.
 * @return New SSL BIO on success, or NULL on failure.
 */
__owur BIO *BIO_new_ssl(SSL_CTX *ctx, int client);
/**
 * @brief Create a BIO chain of an SSL BIO and a connect BIO.
 * @param ctx SSL context used by the SSL BIO.
 * @return New BIO chain on success, or NULL on failure.
 */
__owur BIO *BIO_new_ssl_connect(SSL_CTX *ctx);
/**
 * @brief Create a BIO chain of buffering BIO, SSL BIO, and connect BIO.
 * @param ctx SSL context used by the SSL BIO in the chain.
 * @return New BIO chain on success, or NULL on failure.
 */
__owur BIO *BIO_new_buffer_ssl_connect(SSL_CTX *ctx);
/**
 * @brief Copy the SSL session ID between two BIO chains that contain SSL BIOs.
 * @param to Destination BIO chain whose SSL session is set.
 * @param from Source BIO chain whose SSL session is copied.
 * @return 1 on success, or 0 on failure (including QUIC SSL objects).
 */
__owur int BIO_ssl_copy_session_id(BIO *to, BIO *from);
/**
 * @brief Shut down the SSL session on an SSL BIO chain.
 * @param ssl_bio BIO chain containing an SSL BIO; locates that BIO and calls SSL_shutdown on it.
 */
void BIO_ssl_shutdown(BIO *ssl_bio);

/**
 * @brief Set the TLSv1.2-and-below cipher list for an SSL context.
 * @param ctx SSL context whose new connections inherit the cipher list.
 * @param str Colon-separated cipher list in openssl-ciphers(1) format.
 * @return 1 if at least one cipher could be selected, or 0 on failure.
 */
__owur int SSL_CTX_set_cipher_list(SSL_CTX *ctx, const char *str);
/**
 * @brief Create a new SSL_CTX for connections using method @p meth.
 * @param meth Connection method such as TLS_method() or DTLS_method().
 * @return New SSL_CTX, or NULL on failure; free with SSL_CTX_free.
 */
__owur SSL_CTX *SSL_CTX_new(const SSL_METHOD *meth);
/**
 * @brief Create an SSL_CTX using an explicit library context and property query.
 * @param libctx Library context for algorithm fetches, or NULL for the default.
 * @param propq Property query string for algorithm fetches, or NULL.
 * @param meth Connection method (e.g. TLS_method()) that selects protocol roles.
 * @return New SSL_CTX on success, or NULL on failure.
 */
__owur SSL_CTX *SSL_CTX_new_ex(OSSL_LIB_CTX *libctx, const char *propq,
    const SSL_METHOD *meth);
/**
 * @brief Increment the reference count on an SSL_CTX.
 * @param ctx Context to retain.
 * @return 1 on success, or 0 on failure.
 */
int SSL_CTX_up_ref(SSL_CTX *ctx);
/**
 * @brief Decrement the reference count of an SSL_CTX and free it when it reaches zero.
 * @param ctx SSL context to release, or NULL (no-op).
 */
void SSL_CTX_free(SSL_CTX *ctx);
/**
 * @brief Set the default session timeout for @p ctx in seconds.
 * @param ctx SSL context whose session cache timeout is updated.
 * @param t New timeout in seconds.
 * @return Previous timeout value in seconds.
 */
__owur long SSL_CTX_set_timeout(SSL_CTX *ctx, long t);
/**
 * @brief Return the default session lifetime configured on @p ctx.
 * @param ctx SSL_CTX to query.
 * @return Session timeout in seconds.
 */
__owur long SSL_CTX_get_timeout(const SSL_CTX *ctx);
/**
 * @brief Return the certificate verification store associated with an SSL_CTX.
 * @param ctx SSL context to query.
 * @return Internal X509_STORE pointer (do not free), or NULL if unset.
 */
__owur X509_STORE *SSL_CTX_get_cert_store(const SSL_CTX *ctx);
/**
 * @brief Replace the context certificate store, taking ownership of @p store.
 * @param ctx SSL context whose verification store is replaced.
 * @param store X509_STORE to install; any previous store is freed, and @p store is owned by @p ctx.
 */
void SSL_CTX_set_cert_store(SSL_CTX *ctx, X509_STORE *store);
/**
 * @brief Replace the context certificate store, incrementing @p store's reference count.
 * @param ctx SSL context whose verification store is replaced.
 * @param store X509_STORE to install; any previous store is freed, and @p store's refcount is incremented.
 */
void SSL_CTX_set1_cert_store(SSL_CTX *ctx, X509_STORE *store);
/**
 * @brief Return the non-blocking I/O want state of an SSL connection.
 * @param s SSL connection to query.
 * @return One of SSL_NOTHING, SSL_WRITING, SSL_READING, SSL_X509_LOOKUP, SSL_ASYNC_PAUSED, SSL_ASYNC_NO_JOBS, SSL_CLIENT_HELLO_CB, or SSL_RETRY_VERIFY.
 */
__owur int SSL_want(const SSL *s);
/**
 * @brief Reset an SSL object so it can be reused for another connection.
 * @param s SSL connection to clear; method, ciphers, and BIOs are retained.
 * @return 1 on success, or 0 on failure (including QUIC SSL objects).
 */
__owur int SSL_clear(SSL *s);

/**
 * @brief Remove sessions from the context's internal cache that have expired by @p tm.
 * @param ctx SSL context whose session cache is scanned.
 * @param tm Expiration cutoff time (usually time(0)); sessions expired at or before this time are removed.
 */
void SSL_CTX_flush_sessions(SSL_CTX *ctx, long tm);

/**
 * @brief Return the cipher suite currently in use on an established connection.
 * @param s SSL connection to query.
 * @return Pointer to the active SSL_CIPHER, or NULL if no session has been established.
 */
__owur const SSL_CIPHER *SSL_get_current_cipher(const SSL *s);
/**
 * @brief Return the cipher suite negotiated for upcoming use but not yet active.
 * @param s SSL connection during handshake (for example while an ALPN select callback runs).
 * @return Pointer to the pending SSL_CIPHER, or NULL if none is known yet.
 */
__owur const SSL_CIPHER *SSL_get_pending_cipher(const SSL *s);
/**
 * @brief Return the number of secret bits used by a cipher suite.
 * @param c Cipher suite to query; NULL yields 0.
 * @param alg_bits Optional; when non-NULL, receives the algorithm bit strength.
 * @return Number of secret bits, or 0 if @p c is NULL.
 */
__owur int SSL_CIPHER_get_bits(const SSL_CIPHER *c, int *alg_bits);
/**
 * @brief Return the protocol version name associated with a cipher suite (for example "TLSv1.2").
 * @param c Cipher suite to query.
 * @return Static version string, or "(NONE)" if @p c is NULL.
 */
__owur const char *SSL_CIPHER_get_version(const SSL_CIPHER *c);
/**
 * @brief Return the OpenSSL display name of a cipher suite.
 * @param c Cipher suite to query.
 * @return Static name string, or "(NONE)" if @p c is NULL.
 */
__owur const char *SSL_CIPHER_get_name(const SSL_CIPHER *c);
/**
 * @brief Return the standard RFC name of a cipher suite.
 * @param c Cipher suite to query.
 * @return Static RFC name, "(NONE)" if @p c is NULL, or NULL if the suite has no standard name.
 */
__owur const char *SSL_CIPHER_standard_name(const SSL_CIPHER *c);
/**
 * @brief Map an RFC cipher suite name to the corresponding OpenSSL cipher name.
 * @param rfc_name RFC standard name (for example "TLS_AES_128_GCM_SHA256").
 * @return OpenSSL cipher name string (do not free), or "UNKNOWN" if unmapped.
 */
__owur const char *OPENSSL_cipher_name(const char *rfc_name);
/**
 * @brief Return the OpenSSL-internal 32-bit identifier for cipher @p c.
 * @param c Cipher suite object.
 * @return Cipher id (version bits in the high word, suite id in the low word).
 */
__owur uint32_t SSL_CIPHER_get_id(const SSL_CIPHER *c);
/**
 * @brief Return the two-octet TLS protocol cipher suite identifier.
 * @param c Cipher suite to query.
 * @return Protocol ID as used on the wire in SSLv3/TLS ClientHello/ServerHello.
 */
__owur uint16_t SSL_CIPHER_get_protocol_id(const SSL_CIPHER *c);
/**
 * @brief Return the NID of the key-exchange method used by a cipher suite.
 * @param c Cipher suite to query.
 * @return Key-exchange NID (for example NID_kx_ecdhe), NID_kx_any for TLSv1.3 suites, or NID_undef if none.
 */
__owur int SSL_CIPHER_get_kx_nid(const SSL_CIPHER *c);
/**
 * @brief Return the NID of the authentication method used by a cipher suite.
 * @param c Cipher suite to query.
 * @return Authentication NID (for example NID_auth_ecdsa), NID_auth_any for TLSv1.3 suites, or NID_undef if none.
 */
__owur int SSL_CIPHER_get_auth_nid(const SSL_CIPHER *c);
/**
 * @brief Return the handshake digest used by a cipher suite.
 * @param c Cipher suite to query.
 * @return EVP_MD for the handshake PRF/transcript digest (may differ from the record MAC digest).
 */
__owur const EVP_MD *SSL_CIPHER_get_handshake_digest(const SSL_CIPHER *c);
/**
 * @brief Report whether a cipher suite uses an AEAD construction.
 * @param c Cipher suite to query.
 * @return 1 if the suite is AEAD (for example GCM or ChaCha20-Poly1305), or 0 otherwise.
 */
__owur int SSL_CIPHER_is_aead(const SSL_CIPHER *c);

/**
 * @brief Return the file descriptor linked to an SSL object's read BIO (or the shared fd).
 * @param s SSL connection to query.
 * @return File descriptor >= 0, or -1 if the underlying BIO is not fd-based.
 */
__owur int SSL_get_fd(const SSL *s);
/**
 * @brief Return the file descriptor linked to an SSL object's read BIO.
 * @param s SSL connection to query.
 * @return Read-side file descriptor >= 0, or -1 if the read BIO is not fd-based.
 */
__owur int SSL_get_rfd(const SSL *s);
/**
 * @brief Return the file descriptor linked to an SSL object's write BIO.
 * @param s SSL connection to query.
 * @return Write-side file descriptor >= 0, or -1 if the write BIO is not fd-based.
 */
__owur int SSL_get_wfd(const SSL *s);
/**
 * @brief Return the name of the n-th enabled cipher for a connection (0-based preference order).
 * @param s SSL connection to query.
 * @param n Index into the preference-ordered cipher list.
 * @return Static cipher name, or NULL if @p s is NULL or @p n is out of range.
 */
__owur const char *SSL_get_cipher_list(const SSL *s, int n);
/**
 * @brief Format the shared (mutually supported) ciphers into a colon-separated name string.
 * @param s SSL connection whose peer cipher offer has been received (typically a server).
 * @param buf Caller buffer that receives the NUL-terminated result.
 * @param size Capacity of @p buf in bytes.
 * @return @p buf on success, or NULL on failure / if no shared ciphers are available.
 */
__owur char *SSL_get_shared_ciphers(const SSL *s, char *buf, int size);
/**
 * @brief Report whether an SSL connection will read ahead on its underlying BIO.
 * @param s SSL connection to query.
 * @return Non-zero if read-ahead is enabled, or 0 otherwise.
 */
__owur int SSL_get_read_ahead(const SSL *s);
/**
 * @brief Return how many processed application-data bytes are buffered and ready to read.
 * @param s SSL connection to query.
 * @return Number of bytes available for immediate SSL_read / SSL_read_ex (ignores unprocessed records).
 */
__owur int SSL_pending(const SSL *s);
/**
 * @brief Check whether an SSL object has any buffered record data (processed or not).
 * @param s SSL connection to query.
 * @return 1 if buffered record data is present, or 0 otherwise.
 */
__owur int SSL_has_pending(const SSL *s);
#ifndef OPENSSL_NO_SOCK
/**
 * @brief Attach a bidirectional file descriptor as the I/O channel of an SSL connection.
 * @param s SSL connection to update; creates a socket (or datagram for QUIC) BIO for both directions.
 * @param fd File descriptor used for reading and writing encrypted data.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_fd(SSL *s, int fd);
/**
 * @brief Attach a file descriptor as the read channel of an SSL connection.
 * @param s SSL connection to update; creates a socket (or datagram for QUIC) BIO.
 * @param fd File descriptor used for reading encrypted data.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_rfd(SSL *s, int fd);
/**
 * @brief Attach a file descriptor as the write channel of an SSL connection.
 * @param s SSL connection to update; creates a socket (or datagram for QUIC) BIO.
 * @param fd File descriptor used for writing encrypted data.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_wfd(SSL *s, int fd);
#endif
/**
 * @brief Set the read BIO for an SSL connection, transferring ownership of @p rbio.
 * @param s SSL connection whose read channel is replaced; any previous read BIO is freed.
 * @param rbio BIO used for reading encrypted records; freed when @p s is freed.
 */
void SSL_set0_rbio(SSL *s, BIO *rbio);
/**
 * @brief Set the write BIO for an SSL connection, transferring ownership of @p wbio.
 * @param s SSL connection whose write channel is replaced; any previous write BIO is freed.
 * @param wbio BIO used for writing encrypted records; freed when @p s is freed.
 */
void SSL_set0_wbio(SSL *s, BIO *wbio);
/**
 * @brief Attach read and write BIOs to an SSL connection, transferring ownership as appropriate.
 * @param s SSL connection whose I/O channels are replaced.
 * @param rbio BIO used for reading encrypted records; may equal @p wbio for a shared BIO.
 * @param wbio BIO used for writing encrypted records; freed with @p s subject to reference rules when shared.
 */
/**
 * @brief Attach read and write BIOs to an SSL connection, transferring ownership as appropriate.
 * @param s SSL connection whose I/O channels are replaced.
 * @param rbio BIO used for reading encrypted records; may equal @p wbio for a shared BIO.
 * @param wbio BIO used for writing encrypted records; freed with @p s subject to reference rules when shared.
 */
void SSL_set_bio(SSL *s, BIO *rbio, BIO *wbio);
/**
 * @brief Return the read BIO currently attached to an SSL connection.
 * @param s SSL connection to query.
 * @return Read BIO, or NULL if none is set; do not free (owned by @p s).
 */
__owur BIO *SSL_get_rbio(const SSL *s);
/**
 * @brief Return the write BIO currently attached to an SSL connection.
 * @param s SSL connection to query.
 * @return Write BIO, or NULL if none is set; do not free (owned by @p s).
 */
__owur BIO *SSL_get_wbio(const SSL *s);
/**
 * @brief Set the TLSv1.2-and-below cipher list for a single SSL connection.
 * @param s SSL connection whose cipher list is replaced (does not affect TLSv1.3 suites).
 * @param str Colon-separated cipher list in openssl-ciphers(1) format.
 * @return 1 if at least one cipher could be selected, or 0 on failure.
 */
__owur int SSL_set_cipher_list(SSL *s, const char *str);
/**
 * @brief Set the TLSv1.3 ciphersuite list for an SSL context.
 * @param ctx SSL context to configure.
 * @param str Colon-separated list of TLSv1.3 ciphersuite names.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_ciphersuites(SSL_CTX *ctx, const char *str);
/**
 * @brief Set the TLSv1.3 ciphersuite list for an SSL connection.
 * @param s SSL object to configure.
 * @param str Colon-separated TLSv1.3 ciphersuite names (OpenSSL names).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_ciphersuites(SSL *s, const char *str);
/**
 * @brief Enable or disable read-ahead buffering on SSL @p s.
 * @param s SSL connection.
 * @param yes Nonzero to allow reading ahead into the record buffer; zero to disable.
 */
void SSL_set_read_ahead(SSL *s, int yes);
/**
 * @brief Return the peer certificate verification mode currently set on an SSL connection.
 * @param s SSL connection to query.
 * @return Bitmask of SSL_VERIFY_* flags (for example SSL_VERIFY_NONE or SSL_VERIFY_PEER).
 */
__owur int SSL_get_verify_mode(const SSL *s);
/**
 * @brief Return the maximum depth of the peer certificate chain that will be verified.
 * @param s SSL connection to query.
 * @return Configured verify depth (number of CA certificates allowed above the peer).
 */
__owur int SSL_get_verify_depth(const SSL *s);
/**
 * @brief Return the certificate verification callback set on an SSL connection.
 * @param s SSL connection to query.
 * @return Verify callback previously set with SSL_set_verify(), or NULL if none / using the context default.
 */
__owur SSL_verify_cb SSL_get_verify_callback(const SSL *s);
/**
 * @brief Set peer certificate verification mode and optional verify callback on a connection.
 * @param s SSL connection to configure.
 * @param mode Bitmask of SSL_VERIFY_* flags (for example SSL_VERIFY_PEER).
 * @param callback Per-certificate verify callback, or NULL to keep the existing / context default callback.
 */
void SSL_set_verify(SSL *s, int mode, SSL_verify_cb callback);
/**
 * @brief Set the maximum depth of the peer certificate chain that will be verified on a connection.
 * @param s SSL connection to configure.
 * @param depth Number of CA certificates allowed above the peer end-entity certificate.
 */
void SSL_set_verify_depth(SSL *s, int depth);
/**
 * @brief Install a certificate-selection callback invoked before a cert is used in the handshake.
 * @param s SSL connection (client or server) that will call @p cb.
 * @param cb Callback that may set or clear certificates on @p ssl; return 1 to continue, 0 to abort, or negative to suspend (WANT_X509_LOOKUP); NULL disables the callback.
 * @param arg Opaque pointer passed to @p cb on each invocation.
 */
void SSL_set_cert_cb(SSL *s, int (*cb)(SSL *ssl, void *arg), void *arg);
#ifndef OPENSSL_NO_DEPRECATED_3_0
/**
 * @brief Assign an RSA private key to an SSL connection (deprecated; use SSL_use_PrivateKey).
 * @param ssl SSL connection that receives the key; the RSA reference count is incremented.
 * @param rsa RSA private key that must match any certificate already set on @p ssl.
 * @return 1 on success, or 0 on failure.
 */
OSSL_DEPRECATEDIN_3_0 __owur int SSL_use_RSAPrivateKey(SSL *ssl, RSA *rsa);
/**
 * @brief Load an RSA private key from a DER encoding into an SSL connection (deprecated).
 * @param ssl SSL connection that receives the key.
 * @param d Buffer holding the ASN.1 DER-encoded RSA private key.
 * @param len Length of @p d in bytes.
 * @return 1 on success, or 0 on failure.
 */
OSSL_DEPRECATEDIN_3_0
__owur int SSL_use_RSAPrivateKey_ASN1(SSL *ssl,
    const unsigned char *d, long len);
#endif
/**
 * @brief Assign a private key to an SSL connection (reference count incremented).
 * @param ssl SSL connection that receives the key.
 * @param pkey Private key; must match the certificate set on @p ssl.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_use_PrivateKey(SSL *ssl, EVP_PKEY *pkey);
/**
 * @brief Load a private key of type @p pk from ASN.1 DER into an SSL connection.
 * @param pk Private-key type (EVP_PKEY_* / historical type constants accepted by d2i_PrivateKey).
 * @param ssl SSL connection that receives the key.
 * @param d Buffer holding the ASN.1 DER-encoded private key.
 * @param len Length of @p d in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_use_PrivateKey_ASN1(int pk, SSL *ssl, const unsigned char *d,
    long len);
/**
 * @brief Assign an X509 certificate to an SSL connection (reference count incremented).
 * @param ssl SSL connection that receives the certificate.
 * @param x Certificate to use for this connection.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_use_certificate(SSL *ssl, X509 *x);
/**
 * @brief Load a DER-encoded X.509 certificate into an SSL connection.
 * @param ssl SSL connection that receives the certificate.
 * @param d Buffer holding one certificate in ASN.1/DER form.
 * @param len Length of @p d in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_use_certificate_ASN1(SSL *ssl, const unsigned char *d, int len);
/**
 * @brief Configure an SSL object's certificate, private key, and optional chain.
 * @param ssl SSL connection to update.
 * @param x509 End-entity certificate; reference count is incremented on success.
 * @param privatekey Matching private key; reference count is incremented on success.
 * @param chain Optional intermediate certificates, or NULL.
 * @param override Non-zero to replace an existing cert/key even if already set.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_use_cert_and_key(SSL *ssl, X509 *x509, EVP_PKEY *privatekey,
    STACK_OF(X509) *chain, int override);

/* serverinfo file format versions */
#define SSL_SERVERINFOV1 1
#define SSL_SERVERINFOV2 2

/* Set serverinfo data for the current active cert. */
/**
 * @brief Load serverinfo TLS extensions (SSL_SERVERINFOV1 format) into an SSL context.
 * @param ctx SSL context whose active certificate receives the extensions.
 * @param serverinfo Byte array of one or more V1 extensions (type, length, data).
 * @param serverinfo_length Length of @p serverinfo in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_serverinfo(SSL_CTX *ctx, const unsigned char *serverinfo,
    size_t serverinfo_length);
/**
 * @brief Load serverinfo TLS extensions in V1 or V2 format into an SSL context.
 * @param ctx SSL context whose active certificate receives the extensions.
 * @param version SSL_SERVERINFOV1 or SSL_SERVERINFOV2 describing @p serverinfo layout.
 * @param serverinfo Byte array of one or more serverinfo extensions.
 * @param serverinfo_length Length of @p serverinfo in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_serverinfo_ex(SSL_CTX *ctx, unsigned int version,
    const unsigned char *serverinfo,
    size_t serverinfo_length);
/**
 * @brief Load PEM-encoded serverinfo TLS extensions from a file into an SSL context.
 * @param ctx SSL context whose active certificate receives the extensions.
 * @param file Path to a PEM file with SERVERINFO or SERVERINFOV2 blocks.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_serverinfo_file(SSL_CTX *ctx, const char *file);

#ifndef OPENSSL_NO_DEPRECATED_3_0
/**
 * @brief Load an RSA private key from a PEM/DER file into an SSL connection (deprecated).
 * @param ssl SSL connection that receives the key.
 * @param file Path to the RSA private-key file.
 * @param type Encoding: SSL_FILETYPE_PEM or SSL_FILETYPE_ASN1.
 * @return 1 on success, or 0 on failure.
 */
OSSL_DEPRECATEDIN_3_0
__owur int SSL_use_RSAPrivateKey_file(SSL *ssl, const char *file, int type);
#endif

/**
 * @brief Load the first private key from a file into an SSL connection.
 * @param ssl SSL connection that receives the key.
 * @param file Path to a PEM or DER private-key file.
 * @param type Encoding: SSL_FILETYPE_PEM or SSL_FILETYPE_ASN1.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_use_PrivateKey_file(SSL *ssl, const char *file, int type);
/**
 * @brief Load the first certificate from a file into an SSL connection.
 * @param ssl SSL connection that receives the certificate.
 * @param file Path to a PEM or DER certificate file.
 * @param type Encoding: SSL_FILETYPE_PEM or SSL_FILETYPE_ASN1.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_use_certificate_file(SSL *ssl, const char *file, int type);

#ifndef OPENSSL_NO_DEPRECATED_3_0
/**
 * @brief Load the first RSA private key from a file into an SSL context (deprecated).
 * @param ctx SSL context that receives the key.
 * @param file Path to a PEM or DER private-key file.
 * @param type Encoding: SSL_FILETYPE_PEM or SSL_FILETYPE_ASN1.
 * @return 1 on success, or 0 on failure.
 */
OSSL_DEPRECATEDIN_3_0
__owur int SSL_CTX_use_RSAPrivateKey_file(SSL_CTX *ctx, const char *file,
    int type);
#endif
/**
 * @brief Load a private key from a file into an SSL context.
 * @param ctx SSL context that receives the key.
 * @param file Path to a PEM or DER private-key file.
 * @param type Encoding: SSL_FILETYPE_PEM or SSL_FILETYPE_ASN1.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_PrivateKey_file(SSL_CTX *ctx, const char *file,
    int type);
/**
 * @brief Load a certificate from a file into an SSL context.
 * @param ctx SSL context that receives the certificate.
 * @param file Path to a PEM or ASN.1 certificate file.
 * @param type Encoding: SSL_FILETYPE_PEM or SSL_FILETYPE_ASN1.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_certificate_file(SSL_CTX *ctx, const char *file,
    int type);
/**
 * @brief Load a PEM certificate chain from @p file into @p ctx.
 * @param ctx SSL context that receives the end-entity certificate and any following CA certs.
 * @param file Path to a PEM file containing the leaf certificate followed by optional intermediates.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_certificate_chain_file(SSL_CTX *ctx, const char *file);
/**
 * @brief Load a PEM certificate chain from @p file into @p ssl.
 * @param ssl SSL object that receives the end-entity certificate and intermediates.
 * @param file Path to a PEM file containing the leaf certificate followed by optional CA certs.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_use_certificate_chain_file(SSL *ssl, const char *file);
/**
 * @brief Read certificates from a file and return a stack of their subject names.
 * @param file Path to a PEM file of CA certificates (typically for SSL_set_client_CA_list).
 * @return New STACK_OF(X509_NAME) on success (caller frees with sk_X509_NAME_pop_free), or NULL on failure.
 */
__owur STACK_OF(X509_NAME) *SSL_load_client_CA_file(const char *file);
/**
 * @brief Read certificates from a file and return a stack of their subject names (provider-aware).
 * @param file Path to a PEM file of certificates (typically for SSL_set_client_CA_list).
 * @param libctx Library context used when fetching algorithms from providers, or NULL for the default.
 * @param propq Property query string for provider algorithm selection, or NULL.
 * @return New STACK_OF(X509_NAME) on success (caller frees with sk_X509_NAME_pop_free), or NULL on failure.
 */
__owur STACK_OF(X509_NAME) *SSL_load_client_CA_file_ex(const char *file, OSSL_LIB_CTX *libctx,
    const char *propq);
/**
 * @brief Append subject names from PEM certificates in a file to an existing stack.
 * @param stackCAs Stack of X509_NAME subjects to append to.
 * @param file Path to a PEM file of certificates.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_add_file_cert_subjects_to_stack(STACK_OF(X509_NAME) *stackCAs,
    const char *file);
/**
 * @brief Append subject names from every certificate file in @p dir to @p stackCAs.
 * @param stackCAs Destination stack of X509_NAME values (typically CA subjects).
 * @param dir Directory whose certificate files are scanned.
 * @return 1 on success, or 0 on failure.
 */
int SSL_add_dir_cert_subjects_to_stack(STACK_OF(X509_NAME) *stackCAs,
    const char *dir);
/**
 * @brief Load certificate subjects from an OSSL_STORE URI into a name stack.
 * @param stackCAs Destination stack of X509_NAME subject names.
 * @param uri OSSL_STORE URI identifying a directory, file, or other cert collection.
 * @return 1 on success, or 0 on failure.
 */
int SSL_add_store_cert_subjects_to_stack(STACK_OF(X509_NAME) *stackCAs,
    const char *uri);

#ifndef OPENSSL_NO_DEPRECATED_1_1_0
#define SSL_load_error_strings()                   \
    OPENSSL_init_ssl(OPENSSL_INIT_LOAD_SSL_STRINGS \
            | OPENSSL_INIT_LOAD_CRYPTO_STRINGS,    \
        NULL)
#endif

/**
 * @brief Return a short string describing the current overall state of an SSL connection.
 * @param s SSL connection to query.
 * @return Static NUL-terminated string of at most six characters (for debugging).
 */
__owur const char *SSL_state_string(const SSL *s);
/**
 * @brief Return a short two-letter string for the SSL object's current read state.
 * @param s SSL connection to query.
 * @return Static string such as "RH", "RB", or "RD" describing the read state (for debugging).
 */
__owur const char *SSL_rstate_string(const SSL *s);
/**
 * @brief Return a long descriptive string for the current SSL state.
 * @param s SSL connection to query.
 * @return NUL-terminated state description (do not free).
 */
__owur const char *SSL_state_string_long(const SSL *s);
/**
 * @brief Return a long descriptive string for the SSL object's current read state.
 * @param s SSL connection to query.
 * @return Static string describing the read state (for debugging).
 */
__owur const char *SSL_rstate_string_long(const SSL *s);
/**
 * @brief Return the session creation time as seconds since the Epoch.
 * @param s Session to query.
 * @return Session timestamp, or 0 if unavailable.
 */
__owur long SSL_SESSION_get_time(const SSL_SESSION *s);
/**
 * @brief Set the creation time of an SSL_SESSION (seconds since the Unix epoch).
 * @param s Session to update.
 * @param t New session timestamp.
 * @return 1 on success.
 */
__owur long SSL_SESSION_set_time(SSL_SESSION *s, long t);
/**
 * @brief Return the inactivity timeout (in seconds) configured for an SSL session.
 * @param s Session to query.
 * @return Timeout in seconds, or 0 if @p s is NULL.
 */
__owur long SSL_SESSION_get_timeout(const SSL_SESSION *s);
/**
 * @brief Set the inactivity timeout recorded on an SSL session.
 * @param s Session to update.
 * @param t Timeout in seconds; 0 means the session never times out due to idle time.
 * @return 1 on success, or 0 if @p s is NULL.
 */
__owur long SSL_SESSION_set_timeout(SSL_SESSION *s, long t);
/**
 * @brief Return the protocol version number recorded in an SSL session.
 * @param s Session to query.
 * @return Version constant such as TLS1_3_VERSION.
 */
__owur int SSL_SESSION_get_protocol_version(const SSL_SESSION *s);
/**
 * @brief Set the protocol version recorded on an SSL_SESSION.
 * @param s Session object to update.
 * @param version Wire protocol version constant such as TLS1_3_VERSION.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_SESSION_set_protocol_version(SSL_SESSION *s, int version);

/**
 * @brief Return the session creation time as a time_t (Y2038-safe counterpart to SSL_SESSION_get_time).
 * @param s Session to query.
 * @return Creation time in seconds since the Epoch, or 0 if @p s is NULL.
 */
__owur time_t SSL_SESSION_get_time_ex(const SSL_SESSION *s);
/**
 * @brief Set the session creation time as a time_t (Y2038-safe counterpart to SSL_SESSION_set_time).
 * @param s Session to update.
 * @param t Creation time in seconds since the Epoch.
 * @return @p t on success, or 0 if @p s is NULL.
 */
__owur time_t SSL_SESSION_set_time_ex(SSL_SESSION *s, time_t t);

/**
 * @brief Return the SNI hostname associated with a session, if the server acknowledged SNI.
 * @param s Session to query.
 * @return Pointer to the hostname stored in @p s (do not free), or NULL if none.
 */
__owur const char *SSL_SESSION_get0_hostname(const SSL_SESSION *s);
/**
 * @brief Set the SNI hostname stored on a session to a copy of @p hostname.
 * @param s Session to update.
 * @param hostname Hostname string to copy, or NULL to clear.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_SESSION_set1_hostname(SSL_SESSION *s, const char *hostname);
/**
 * @brief Retrieve the ALPN protocol selected for a session and its length.
 * @param s Session to query.
 * @param alpn On return, set to a pointer to the protocol bytes inside @p s (do not free).
 * @param len On return, set to the length of the protocol in bytes.
 */
void SSL_SESSION_get0_alpn_selected(const SSL_SESSION *s,
    const unsigned char **alpn,
    size_t *len);
/**
 * @brief Set the ALPN protocol recorded on a session to a copy of @p alpn.
 * @param s Session to update.
 * @param alpn Protocol name bytes (not necessarily NUL-terminated).
 * @param len Length of @p alpn in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_SESSION_set1_alpn_selected(SSL_SESSION *s,
    const unsigned char *alpn,
    size_t len);
/**
 * @brief Return the cipher suite stored on an SSL_SESSION.
 * @param s Session to query.
 * @return Pointer to the SSL_CIPHER, or NULL if unset; do not free.
 */
__owur const SSL_CIPHER *SSL_SESSION_get0_cipher(const SSL_SESSION *s);
/**
 * @brief Associate a cipher suite with an SSL_SESSION (for example when building a PSK session).
 * @param s Session to update.
 * @param cipher Cipher suite to store on @p s.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_SESSION_set_cipher(SSL_SESSION *s, const SSL_CIPHER *cipher);
/**
 * @brief Report whether a session ticket is present on a session.
 * @param s Session to query.
 * @return 1 if a ticket is associated with @p s, or 0 otherwise.
 */
__owur int SSL_SESSION_has_ticket(const SSL_SESSION *s);
/**
 * @brief Return the session-ticket lifetime hint in seconds.
 * @param s Session to query.
 * @return Lifetime hint advertised with the ticket, in seconds.
 */
__owur unsigned long SSL_SESSION_get_ticket_lifetime_hint(const SSL_SESSION *s);
/**
 * @brief Obtain a pointer to the session ticket bytes stored on a session.
 * @param s Session to query.
 * @param tick Optional; when non-NULL, set to a pointer to the ticket bytes inside @p s (valid while @p s is).
 * @param len On return, set to the ticket length in bytes.
 */
void SSL_SESSION_get0_ticket(const SSL_SESSION *s, const unsigned char **tick,
    size_t *len);
/**
 * @brief Return the maximum early-data (0-RTT) size allowed for a session.
 * @param s Session to query (typically from a prior handshake with the server).
 * @return Maximum early-data bytes that may be sent when resuming @p s, or 0 if early data is not allowed.
 */
__owur uint32_t SSL_SESSION_get_max_early_data(const SSL_SESSION *s);
/**
 * @brief Set the maximum early-data (0-RTT) size advertised for a session.
 * @param s Session to update.
 * @param max_early_data Maximum early-data bytes allowed when resuming @p s.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_SESSION_set_max_early_data(SSL_SESSION *s,
    uint32_t max_early_data);
/**
 * @brief Copy the session, method, certificate, and session-id context from one SSL object to another.
 * @param to Destination SSL connection that receives the copied state.
 * @param from Source SSL connection whose session and related state are copied.
 * @return 1 on success, or 0 on failure (including when either object is QUIC-only).
 */
__owur int SSL_copy_session_id(SSL *to, const SSL *from);
/**
 * @brief Return the peer certificate stored in an SSL session (borrowed pointer).
 * @param s Session to query.
 * @return Peer X509 certificate, or NULL if none is available; do not free unless X509_up_ref was called.
 */
__owur X509 *SSL_SESSION_get0_peer(SSL_SESSION *s);
/**
 * @brief Set the session ID context used to restrict session reuse.
 * @param s Session to update.
 * @param sid_ctx Context bytes that must match SSL_CTX_set_session_id_context().
 * @param sid_ctx_len Length of @p sid_ctx (at most SSL_MAX_SID_CTX_LENGTH).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_SESSION_set1_id_context(SSL_SESSION *s,
    const unsigned char *sid_ctx,
    unsigned int sid_ctx_len);
/**
 * @brief Set the session ID bytes stored on an SSL_SESSION.
 * @param s Session to update.
 * @param sid Session ID bytes to copy.
 * @param sid_len Length of @p sid (must not exceed SSL_MAX_SSL_SESSION_ID_LENGTH).
 * @return 1 on success, or 0 on failure (for example if @p sid_len is too large).
 */
__owur int SSL_SESSION_set1_id(SSL_SESSION *s, const unsigned char *sid,
    unsigned int sid_len);
/**
 * @brief Report whether a session may be used for resumption / PSK.
 * @param s Session to query.
 * @return 1 if the session is resumable, or 0 otherwise.
 */
__owur int SSL_SESSION_is_resumable(const SSL_SESSION *s);

/**
 * @brief Allocate a new empty SSL_SESSION structure.
 * @return New SSL_SESSION on success, or NULL on failure.
 */
__owur SSL_SESSION *SSL_SESSION_new(void);
/**
 * @brief Duplicate an SSL_SESSION; the copy is not owned by any session cache.
 * @param src Session to copy.
 * @return New SSL_SESSION copy on success, or NULL on failure.
 */
__owur SSL_SESSION *SSL_SESSION_dup(const SSL_SESSION *src);
/**
 * @brief Return the session identifier bytes of an SSL_SESSION.
 * @param s Session to query.
 * @param len If non-NULL, receives the session-id length in bytes (0..SSL_MAX_SSL_SESSION_ID_LENGTH).
 * @return Pointer to the internal session-id bytes (do not free).
 */
const unsigned char *SSL_SESSION_get_id(const SSL_SESSION *s,
    unsigned int *len);
/**
 * @brief Return the session-id context bytes associated with a session.
 * @param s Session to query.
 * @param len If non-NULL, receives the context length in bytes.
 * @return Pointer to the internal context bytes (do not free), or NULL if unset.
 */
const unsigned char *SSL_SESSION_get0_id_context(const SSL_SESSION *s,
    unsigned int *len);
/**
 * @brief Return the compression method identifier negotiated for a session.
 * @param s Session to query.
 * @return Compression method id (1 for zlib), or 0 if compression was not negotiated.
 */
__owur unsigned int SSL_SESSION_get_compress_id(const SSL_SESSION *s);
#ifndef OPENSSL_NO_STDIO
/**
 * @brief Print a human-readable summary of an SSL_SESSION to a FILE.
 * @param fp Output stream.
 * @param ses Session to describe.
 * @return 1 on success, or 0 on failure.
 */
int SSL_SESSION_print_fp(FILE *fp, const SSL_SESSION *ses);
#endif
/**
 * @brief Print a human-readable summary of an SSL_SESSION to a BIO.
 * @param fp Output BIO.
 * @param ses Session to describe.
 * @return 1 on success, or 0 on failure.
 */
int SSL_SESSION_print(BIO *fp, const SSL_SESSION *ses);
/**
 * @brief Print session keying material to a BIO in NSS keylog format.
 * @param bp Output BIO.
 * @param x Session whose secrets are logged.
 * @return 1 on success, or 0 on failure.
 */
int SSL_SESSION_print_keylog(BIO *bp, const SSL_SESSION *x);
/**
 * @brief Increment the reference count of an SSL_SESSION.
 * @param ses Session whose reference count is increased.
 * @return 1 on success, or 0 on failure.
 */
int SSL_SESSION_up_ref(SSL_SESSION *ses);
/**
 * @brief Decrement the reference count of an SSL_SESSION and free it when it reaches zero.
 * @param ses Session to release; NULL is ignored.
 */
void SSL_SESSION_free(SSL_SESSION *ses);
/**
 * @brief Encode an SSL_SESSION into its ASN.1 DER representation (i2d style).
 * @param in Session to encode; must be valid or the call fails with no output.
 * @param pp Optional; when non-NULL, receives / advances the output buffer pointer as in other i2d_* helpers.
 * @return Length of the DER encoding in bytes, or 0 if the session is not valid.
 */
__owur int i2d_SSL_SESSION(const SSL_SESSION *in, unsigned char **pp);
/**
 * @brief Attach a session to an SSL object for client-side resumption.
 * @param to SSL connection that will offer @p session.
 * @param session Session to resume; reference count is incremented on success.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_session(SSL *to, SSL_SESSION *session);
/**
 * @brief Add a session to an SSL context's internal session cache.
 * @param ctx SSL context whose cache receives @p session.
 * @param session Session to cache; reference count is incremented on success.
 * @return 1 on success, or 0 if the session was already present or on error.
 */
int SSL_CTX_add_session(SSL_CTX *ctx, SSL_SESSION *session);
/**
 * @brief Remove a session from an SSL context's internal session cache and mark it non-resumable.
 * @param ctx SSL context whose cache is updated.
 * @param session Session to remove; SSL_SESSION_free is called once for it.
 * @return 1 on success, or 0 if the session was not found in the cache.
 */
int SSL_CTX_remove_session(SSL_CTX *ctx, SSL_SESSION *session);
/**
 * @brief Set the callback used to generate new session IDs for server SSL objects from a context.
 * @param ctx Server SSL context whose session-ID generator is replaced.
 * @param cb Generator callback; see GEN_SESSION_CB.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_generate_session_id(SSL_CTX *ctx, GEN_SESSION_CB cb);
/**
 * @brief Set the callback used to generate new session IDs for a server SSL connection.
 * @param s SSL connection (server) whose session-ID generator is replaced.
 * @param cb Generator callback; see GEN_SESSION_CB.
 * @return 1 on success.
 */
__owur int SSL_set_generate_session_id(SSL *s, GEN_SESSION_CB cb);
/**
 * @brief Test whether a session ID is already present in the parent context's internal session cache.
 * @param s SSL connection whose parent SSL_CTX cache is searched.
 * @param id Session ID bytes to look up.
 * @param id_len Length of @p id in bytes.
 * @return 1 if a matching cached session exists, or 0 otherwise.
 */
__owur int SSL_has_matching_session_id(const SSL *s,
    const unsigned char *id,
    unsigned int id_len);
/**
 * @brief Decode an SSL_SESSION from its ASN.1 DER encoding.
 * @param a Optional destination pointer updated to the result, or NULL.
 * @param pp Address of a pointer to the DER input; advanced past the decoded value.
 * @param length Number of bytes available at *@p pp.
 * @return Decoded SSL_SESSION, or NULL on error; free with SSL_SESSION_free().
 */
SSL_SESSION *d2i_SSL_SESSION(SSL_SESSION **a, const unsigned char **pp,
    long length);
/**
 * @brief Decode an SSL_SESSION from DER with an explicit library context.
 * @param a Optional destination pointer updated to the result, or NULL.
 * @param pp Address of a pointer to the DER input; advanced past the decoded value.
 * @param length Number of bytes available at *@p pp.
 * @param libctx Library context for algorithm fetches, or NULL for the default.
 * @param propq Property query for algorithm fetches, or NULL.
 * @return Decoded SSL_SESSION, or NULL on error.
 */
SSL_SESSION *d2i_SSL_SESSION_ex(SSL_SESSION **a, const unsigned char **pp,
    long length, OSSL_LIB_CTX *libctx,
    const char *propq);

#ifdef OPENSSL_X509_H
/**
 * @brief Return the peer's leaf certificate without incrementing its reference count.
 * @param s SSL connection after a handshake that presented a certificate.
 * @return Peer X509 (owned by @p s; do not free), or NULL if none is available.
 */
__owur X509 *SSL_get0_peer_certificate(const SSL *s);
/**
 * @brief Return the peer's end-entity X509 certificate, incrementing its reference count.
 * @param s SSL connection whose peer certificate is retrieved.
 * @return Peer certificate (caller must X509_free), or NULL if none was presented / no connection.
 */
__owur X509 *SSL_get1_peer_certificate(const SSL *s);
/* Deprecated in 3.0.0 */
#ifndef OPENSSL_NO_DEPRECATED_3_0
#define SSL_get_peer_certificate SSL_get1_peer_certificate
#endif
#endif

/**
 * @brief Return the certificate chain as sent by the peer (not necessarily the verified chain).
 * @param s SSL connection to query; on the server the peer leaf must be obtained separately.
 * @return STACK_OF(X509) owned by the session (do not free; may be invalidated by renegotiation), or NULL.
 */
__owur STACK_OF(X509) *SSL_get_peer_cert_chain(const SSL *s);

/**
 * @brief Return the peer certificate verification mode currently set on an SSL context.
 * @param ctx SSL context to query.
 * @return Bitmask of SSL_VERIFY_* flags previously set with SSL_CTX_set_verify().
 */
__owur int SSL_CTX_get_verify_mode(const SSL_CTX *ctx);
/**
 * @brief Return the maximum depth of certificate chain verification for an SSL context.
 * @param ctx SSL context to query.
 * @return Verify depth previously set with SSL_CTX_set_verify_depth() (0 means only the peer certificate).
 */
__owur int SSL_CTX_get_verify_depth(const SSL_CTX *ctx);
/**
 * @brief Return the certificate verification callback set on an SSL context.
 * @param ctx SSL context to query.
 * @return Verify callback previously set with SSL_CTX_set_verify(), or NULL if none (default callback used).
 */
__owur SSL_verify_cb SSL_CTX_get_verify_callback(const SSL_CTX *ctx);
/**
 * @brief Set peer certificate verification mode and optional callback for an SSL context.
 * @param ctx SSL context whose default verify settings are updated (inherited by SSL_new).
 * @param mode Bitmask of SSL_VERIFY_* flags controlling whether and how peers are verified.
 * @param callback Optional verify callback invoked during certificate checking, or NULL for the default.
 */
/**
 * @brief Set peer certificate verification mode and optional callback for an SSL context.
 * @param ctx SSL context whose default verify settings are updated (inherited by SSL_new).
 * @param mode Bitmask of SSL_VERIFY_* flags controlling whether and how peers are verified.
 * @param callback Optional verify callback invoked during certificate checking, or NULL for the default.
 */
void SSL_CTX_set_verify(SSL_CTX *ctx, int mode, SSL_verify_cb callback);
/**
 * @brief Set the maximum depth of CA certificates allowed above the peer for context-wide verification.
 * @param ctx SSL context whose default verify depth is set (inherited by SSL_new).
 * @param depth Maximum number of intermediate CA certificates permitted in the chain.
 */
void SSL_CTX_set_verify_depth(SSL_CTX *ctx, int depth);
/**
 * @brief Replace the built-in peer certificate verification procedure with an application callback.
 * @param ctx SSL context; SSL objects created from it inherit @p cb and @p arg at SSL_new time.
 * @param cb Verification callback receiving the X509_STORE_CTX and @p arg; return 1 to accept, 0 to fail; NULL restores the default.
 * @param arg Application pointer passed to @p cb on each invocation.
 */
void SSL_CTX_set_cert_verify_callback(SSL_CTX *ctx,
    int (*cb)(X509_STORE_CTX *, void *),
    void *arg);
/**
 * @brief Install a certificate-selection callback invoked during handshake certificate setup.
 * @param c SSL_CTX that owns the callback.
 * @param cb Callback that should install certs/keys on @p ssl and return 1 on success, 0 to defer, or <0 on error.
 * @param arg Opaque pointer passed to @p cb.
 */
void SSL_CTX_set_cert_cb(SSL_CTX *c, int (*cb)(SSL *ssl, void *arg),
    void *arg);
#ifndef OPENSSL_NO_DEPRECATED_3_0
/**
 * @brief Assign an RSA private key to an SSL context (deprecated; use SSL_CTX_use_PrivateKey).
 * @param ctx SSL context that receives the key; the RSA reference count is incremented.
 * @param rsa RSA private key that must match any certificate already set on @p ctx.
 * @return 1 on success, or 0 on failure.
 */
OSSL_DEPRECATEDIN_3_0
__owur int SSL_CTX_use_RSAPrivateKey(SSL_CTX *ctx, RSA *rsa);
/**
 * @brief Load an RSA private key from a DER buffer into an SSL context (deprecated).
 * @param ctx SSL context that receives the key.
 * @param d DER-encoded RSAPrivateKey bytes.
 * @param len Length of @p d in bytes.
 * @return 1 on success, or 0 on failure.
 */
OSSL_DEPRECATEDIN_3_0
__owur int SSL_CTX_use_RSAPrivateKey_ASN1(SSL_CTX *ctx, const unsigned char *d,
    long len);
#endif
/**
 * @brief Assign an EVP_PKEY private key to an SSL context.
 * @param ctx SSL context that receives the key; the key's reference count is incremented on success.
 * @param pkey Private key that must match any certificate already set on @p ctx.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_PrivateKey(SSL_CTX *ctx, EVP_PKEY *pkey);
/**
 * @brief Install a private key of type @p pk from a DER buffer on an SSL context.
 * @param pk Private-key ASN.1 type such as EVP_PKEY_RSA or EVP_PKEY_EC.
 * @param ctx SSL context that receives the key; it must match any certificate already set.
 * @param d Buffer containing a DER-encoded private key of type @p pk.
 * @param len Length of @p d in bytes.
 * @return 1 on success, or 0 on failure.
 */
/**
 * @brief Install a private key of type @p pk from a DER buffer on an SSL context.
 * @param pk Private-key ASN.1 type such as EVP_PKEY_RSA or EVP_PKEY_EC.
 * @param ctx SSL context that receives the key; it must match any certificate already set.
 * @param d Buffer containing a DER-encoded private key of type @p pk.
 * @param len Length of @p d in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_PrivateKey_ASN1(int pk, SSL_CTX *ctx,
    const unsigned char *d, long len);
/**
 * @brief Set the end-entity certificate used by an SSL context.
 * @param ctx SSL context that receives the certificate.
 * @param x Certificate to install; reference count is incremented on success.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_certificate(SSL_CTX *ctx, X509 *x);
/**
 * @brief Load a certificate into an SSL context from a DER encoding.
 * @param ctx SSL context that receives the certificate.
 * @param len Number of bytes at @p d.
 * @param d DER-encoded X.509 certificate.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_certificate_ASN1(SSL_CTX *ctx, int len,
    const unsigned char *d);
/**
 * @brief Assign a certificate, private key, and optional chain onto an SSL context.
 * @param ctx SSL context that receives the credentials.
 * @param x509 End-entity X.509 certificate (reference count incremented on success).
 * @param privatekey Matching private key, or NULL to use @p x509's public key (e.g. hardware ENGINE).
 * @param chain Optional intermediate certificate chain, or NULL.
 * @param override If 0, set only when cert/key/chain were all previously unset; if non-zero, always replace.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_use_cert_and_key(SSL_CTX *ctx, X509 *x509, EVP_PKEY *privatekey,
    STACK_OF(X509) *chain, int override);

/**
 * @brief Set the default password callback used when loading encrypted PEM material into a context.
 * @param ctx SSL context whose PEM password callback is replaced.
 * @param cb Password callback (see pem_password_cb), or NULL to clear.
 */
void SSL_CTX_set_default_passwd_cb(SSL_CTX *ctx, pem_password_cb *cb);
/**
 * @brief Set userdata passed to the context's default PEM password callback.
 * @param ctx SSL context whose callback userdata is stored.
 * @param u Pointer provided as the userdata argument to the password callback.
 */
void SSL_CTX_set_default_passwd_cb_userdata(SSL_CTX *ctx, void *u);
/**
 * @brief Return the default PEM password callback currently set on an SSL context.
 * @param ctx SSL context to query.
 * @return Password callback, or NULL if none was set explicitly.
 */
pem_password_cb *SSL_CTX_get_default_passwd_cb(SSL_CTX *ctx);
/**
 * @brief Return the userdata pointer passed to the context's default PEM password callback.
 * @param ctx SSL context to query.
 * @return Userdata previously set with SSL_CTX_set_default_passwd_cb_userdata, or NULL if unset.
 */
void *SSL_CTX_get_default_passwd_cb_userdata(SSL_CTX *ctx);
/**
 * @brief Set the default PEM password callback used when loading keys on an SSL.
 * @param s SSL connection to update.
 * @param cb Password callback, or NULL to clear.
 */
void SSL_set_default_passwd_cb(SSL *s, pem_password_cb *cb);
/**
 * @brief Set the user-data pointer passed to an SSL object's PEM password callback.
 * @param s SSL connection whose password callback userdata is set.
 * @param u Pointer forwarded to the pem_password_cb as u.
 */
void SSL_set_default_passwd_cb_userdata(SSL *s, void *u);
/**
 * @brief Return the default PEM password callback currently set on an SSL connection.
 * @param s SSL connection to query.
 * @return Password callback, or NULL if none was set explicitly.
 */
pem_password_cb *SSL_get_default_passwd_cb(SSL *s);
/**
 * @brief Return the user-data pointer passed to an SSL object's PEM password callback.
 * @param s SSL connection to query.
 * @return Pointer previously set with SSL_set_default_passwd_cb_userdata(), or NULL.
 */
void *SSL_get_default_passwd_cb_userdata(SSL *s);

/**
 * @brief Verify that the private key configured on an SSL_CTX matches its certificate.
 * @param ctx SSL context whose default certificate and private key are compared.
 * @return 1 if the key matches the certificate (or neither is set), or 0 on mismatch/error.
 */
__owur int SSL_CTX_check_private_key(const SSL_CTX *ctx);
/**
 * @brief Verify that the private key configured on an SSL matches its certificate.
 * @param ctx SSL connection whose certificate and private key are compared.
 * @return 1 if the key matches the certificate (or neither is set), or 0 on mismatch/error.
 */
__owur int SSL_check_private_key(const SSL *ctx);

/**
 * @brief Set the server-side session-id context within which sessions may be reused for a context.
 * @param ctx SSL context (server) whose sid_ctx is set and inherited by new SSL objects.
 * @param sid_ctx Opaque application context bytes stored with exported sessions.
 * @param sid_ctx_len Length of @p sid_ctx (must not exceed SSL_MAX_SID_CTX_LENGTH).
 * @return 1 on success, or 0 if @p sid_ctx_len is too large.
 */
__owur int SSL_CTX_set_session_id_context(SSL_CTX *ctx,
    const unsigned char *sid_ctx,
    unsigned int sid_ctx_len);

/**
 * @brief Create a new SSL connection object that inherits settings from an SSL_CTX.
 * @param ctx Context providing method, options, verify settings, timeouts, and related defaults.
 * @return New SSL object with reference count 1, or NULL on failure.
 */
SSL *SSL_new(SSL_CTX *ctx);
/**
 * @brief Increment the reference count of an SSL connection object.
 * @param s SSL object whose reference count is increased.
 * @return 1 on success, or 0 on failure.
 */
int SSL_up_ref(SSL *s);
/**
 * @brief Test whether an SSL object is using the DTLS protocol.
 * @param s SSL connection to query.
 * @return 1 if the connection uses DTLS, or 0 otherwise.
 */
int SSL_is_dtls(const SSL *s);
/**
 * @brief Report whether a connection is using SSL/TLS (as opposed to DTLS or QUIC).
 * @param s SSL object to query.
 * @return 1 if the connection uses SSL/TLS, or 0 otherwise.
 */
int SSL_is_tls(const SSL *s);
/**
 * @brief Report whether a connection is using QUIC (as opposed to TLS or DTLS).
 * @param s SSL object to query.
 * @return 1 if the connection uses QUIC, or 0 otherwise.
 */
int SSL_is_quic(const SSL *s);
/**
 * @brief Set the server-side session-id context for a single SSL connection.
 * @param ssl SSL connection (server) whose sid_ctx is set.
 * @param sid_ctx Opaque application context bytes.
 * @param sid_ctx_len Length of @p sid_ctx (must not exceed SSL_MAX_SID_CTX_LENGTH).
 * @return 1 on success, or 0 if @p sid_ctx_len is too large.
 */
__owur int SSL_set_session_id_context(SSL *ssl, const unsigned char *sid_ctx,
    unsigned int sid_ctx_len);

/**
 * @brief Set the X509 purpose on an SSL context's verification parameters.
 * @param ctx SSL context whose X509_VERIFY_PARAM purpose is updated.
 * @param purpose Purpose identifier (see X509_PURPOSE_* / X509_VERIFY_PARAM_set_purpose).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_purpose(SSL_CTX *ctx, int purpose);
/**
 * @brief Set the X509 purpose on an SSL connection's verification parameters.
 * @param ssl SSL connection whose X509_VERIFY_PARAM purpose is updated.
 * @param purpose Purpose identifier (see X509_PURPOSE_* / X509_VERIFY_PARAM_set_purpose).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_purpose(SSL *ssl, int purpose);
/**
 * @brief Set the default X509 trust purpose NID for certificate verification on a context.
 * @param ctx SSL context to configure.
 * @param trust Trust purpose such as X509_TRUST_SSL_CLIENT or X509_TRUST_SSL_SERVER.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_trust(SSL_CTX *ctx, int trust);
/**
 * @brief Set the X509 trust setting on an SSL connection's verification parameters.
 * @param ssl SSL connection whose X509_VERIFY_PARAM trust is updated.
 * @param trust Trust identifier (see X509_TRUST_* / X509_VERIFY_PARAM_set_trust).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_trust(SSL *ssl, int trust);

/**
 * @brief Set the expected DNS hostname used for certificate name checks (and SNI).
 * @param s SSL connection.
 * @param hostname DNS name to verify against the peer certificate; clears prior names.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set1_host(SSL *s, const char *hostname);
/**
 * @brief Add an additional expected DNS hostname for peer certificate name checks.
 * @param s Client SSL connection; existing hostnames from SSL_set1_host / SSL_add1_host are retained.
 * @param hostname Hostname to add; NULL or empty leaves the list unchanged.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_add1_host(SSL *s, const char *hostname);
/**
 * @brief Return the peer certificate DNS name or subject CN that matched a configured reference identifier.
 * @param s SSL connection after hostname verification.
 * @return Matched peer name (library-owned; invalid after clear/free/renegotiate), or NULL if none / not applicable.
 */
__owur const char *SSL_get0_peername(SSL *s);
/**
 * @brief Set X509_CHECK_FLAG_* host-checking flags for certificate hostname matching.
 * @param s SSL connection whose verification host flags are set.
 * @param flags Bitmask of X509_CHECK_FLAG_* values.
 */
void SSL_set_hostflags(SSL *s, unsigned int flags);

/**
 * @brief Initialize shared DANE TLSA authentication state on an SSL context.
 * @param ctx Client SSL context that will create DANE-enabled SSL connections.
 * @return Positive value on success, 0 for invalid usage, or a negative value on resource failure.
 */
__owur int SSL_CTX_dane_enable(SSL_CTX *ctx);
/**
 * @brief Map a DANE TLSA matching type to a digest algorithm for a context.
 * @param ctx DANE-enabled SSL context; call before creating SSL objects from it.
 * @param md Digest algorithm for @p mtype, or NULL to disable that matching type.
 * @param mtype TLSA matching type (Full(0) cannot be changed or disabled).
 * @param ord Relative strength ordinal used for RFC7671 digest agility (larger is stronger).
 * @return Positive value on success, 0 for invalid input, or a negative value on resource failure.
 */
__owur int SSL_CTX_dane_mtype_set(SSL_CTX *ctx, const EVP_MD *md,
    uint8_t mtype, uint8_t ord);
/**
 * @brief Enable DANE TLSA authentication for a connection (must be called before the handshake).
 * @param s SSL connection associated with a DANE-enabled SSL_CTX.
 * @param basedomain Base domain name used for DANE name checks / TLSA lookup context.
 * @return Positive value on success, 0 on invalid usage, or a negative value on resource failure.
 */
__owur int SSL_dane_enable(SSL *s, const char *basedomain);
/**
 * @brief Add a DANE TLSA record used to authenticate the peer on a connection.
 * @param s DANE-enabled SSL connection that will use the record during verification.
 * @param usage TLSA certificate usage field.
 * @param selector TLSA selector field.
 * @param mtype TLSA matching type field.
 * @param data Binary association data for the TLSA record.
 * @param dlen Length of @p data in bytes.
 * @return Positive value on success, 0 for invalid input, or a negative value on resource failure.
 */
__owur int SSL_dane_tlsa_add(SSL *s, uint8_t usage, uint8_t selector,
    uint8_t mtype, const unsigned char *data, size_t dlen);
/**
 * @brief Return the matching DANE-TA / DANE-EE authority depth and optional anchors.
 * @param s SSL connection that completed DANE verification.
 * @param mcert If non-NULL, receives the matching certificate when applicable (borrowed).
 * @param mspki If non-NULL, receives the matching public key when applicable (borrowed).
 * @return Depth of the matching authority (>=0), or a negative value if none.
 */
__owur int SSL_get0_dane_authority(SSL *s, X509 **mcert, EVP_PKEY **mspki);
/**
 * @brief Return the matching DANE TLSA record fields after successful authentication.
 * @param s SSL connection that completed DANE peer authentication.
 * @param usage Optional; receives the TLSA certificate usage of the matching record.
 * @param selector Optional; receives the TLSA selector of the matching record.
 * @param mtype Optional; receives the TLSA matching type of the matching record.
 * @param data Optional; receives a pointer to the matching association data (do not free).
 * @param dlen Optional; receives the length of @p data in bytes.
 * @return Nonnegative chain depth of the match on success, or a negative value if DANE failed or was not enabled.
 */
__owur int SSL_get0_dane_tlsa(SSL *s, uint8_t *usage, uint8_t *selector,
    uint8_t *mtype, const unsigned char **data,
    size_t *dlen);
/**
 * @brief Return the internal SSL_DANE state for @p ssl (libcrypto/libssl bridge).
 * @param ssl SSL connection whose DANE state is queried.
 * @return Internal SSL_DANE pointer owned by @p ssl; do not free. Also used by offline DANE tests.
 */
SSL_DANE *SSL_get0_dane(SSL *ssl);
/*
 * DANE flags
 */
/**
 * @brief Set selected DANE option flags on an SSL_CTX.
 * @param ctx SSL context whose DANE flags are updated.
 * @param flags DANE flag bits to set (for example DANE_FLAG_NO_DANE_EE_NAMECHECKS).
 * @return The resulting DANE flag mask after setting.
 */
unsigned long SSL_CTX_dane_set_flags(SSL_CTX *ctx, unsigned long flags);
/**
 * @brief Clear selected DANE option flags on an SSL_CTX.
 * @param ctx SSL context whose DANE flags are updated.
 * @param flags DANE flag bits to clear (for example DANE_FLAG_NO_DANE_EE_NAMECHECKS).
 * @return The resulting DANE flag mask after clearing.
 */
unsigned long SSL_CTX_dane_clear_flags(SSL_CTX *ctx, unsigned long flags);
/**
 * @brief Set selected DANE option flags on an SSL connection.
 * @param ssl SSL connection whose DANE flags are updated.
 * @param flags DANE flag bits to set (for example DANE_FLAG_NO_DANE_EE_NAMECHECKS).
 * @return The resulting DANE flag mask after setting.
 */
unsigned long SSL_dane_set_flags(SSL *ssl, unsigned long flags);
/**
 * @brief Clear DANE authentication feature flags on an SSL connection.
 * @param ssl SSL object whose DANE flags are updated.
 * @param flags Bit-mask of DANE feature flags to clear.
 * @return Flags in effect before this call.
 */
unsigned long SSL_dane_clear_flags(SSL *ssl, unsigned long flags);

/**
 * @brief Copy verification parameters into an SSL context.
 * @param ctx SSL context whose X509_VERIFY_PARAM is updated.
 * @param vpm Source parameters that are duplicated into @p ctx.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set1_param(SSL_CTX *ctx, X509_VERIFY_PARAM *vpm);
/**
 * @brief Copy verification parameters into an SSL connection.
 * @param ssl SSL connection whose X509_VERIFY_PARAM is updated.
 * @param vpm Source parameters that are duplicated into @p ssl.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set1_param(SSL *ssl, X509_VERIFY_PARAM *vpm);

/**
 * @brief Return a non-owning pointer to an SSL context's verification parameters.
 * @param ctx SSL context to query.
 * @return Internal X509_VERIFY_PARAM pointer; do not free.
 */
__owur X509_VERIFY_PARAM *SSL_CTX_get0_param(SSL_CTX *ctx);
/**
 * @brief Return a non-owning pointer to an SSL connection's verification parameters.
 * @param ssl SSL connection to query.
 * @return Internal X509_VERIFY_PARAM pointer; do not free.
 */
__owur X509_VERIFY_PARAM *SSL_get0_param(SSL *ssl);

#ifndef OPENSSL_NO_SRP
#ifndef OPENSSL_NO_DEPRECATED_3_0
/**
 * @brief Set the default SRP username for clients created from a context (deprecated).
 * @param ctx Client SSL context that stores the username; call before creating the connection.
 * @param name SRP username (at most 255 characters).
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0 int SSL_CTX_set_srp_username(SSL_CTX *ctx, char *name);
/**
 * @brief Set the default SRP password for clients created from a context (deprecated).
 * @param ctx Client SSL context that stores the password; overrides SSL_CTX_set_srp_client_pwd_callback.
 * @param password Password string used for SRP authentication.
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0 int SSL_CTX_set_srp_password(SSL_CTX *ctx, char *password);
/**
 * @brief Set the minimum acceptable SRP prime length in bits for a context (deprecated).
 * @param ctx SSL context whose SRP strength is updated; default is 1024 when unset.
 * @param strength Minimum SRP prime size in bits; server key exchange below this is rejected.
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0 int SSL_CTX_set_srp_strength(SSL_CTX *ctx, int strength);
/**
 * @brief Set a client callback that supplies the SRP password (deprecated).
 * @param ctx Client SSL context that invokes @p cb during SRP authentication.
 * @param cb Callback returning a password for the given SSL and user argument from SSL_CTX_set_srp_cb_arg.
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0
int SSL_CTX_set_srp_client_pwd_callback(SSL_CTX *ctx,
    char *(*cb)(SSL *, void *));
/**
 * @brief Set a client callback that verifies server SRP group parameters (deprecated).
 * @param ctx Client SSL context that invokes @p cb when the server proposes SRP N and g.
 * @param cb Callback receiving the SSL and the argument from SSL_CTX_set_srp_cb_arg;
 *           return a positive value to accept, or 0/negative to abort.
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0
int SSL_CTX_set_srp_verify_param_callback(SSL_CTX *ctx,
    int (*cb)(SSL *, void *));
/**
 * @brief Set the server callback invoked when an SRP username appears in ClientHello (deprecated).
 * @param ctx Server SSL context that invokes @p cb to configure SRP parameters via SSL_set_srp_server_param.
 * @param cb Callback receiving the SSL, a writable alert/error code, and the argument from SSL_CTX_set_srp_cb_arg.
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0
int SSL_CTX_set_srp_username_callback(SSL_CTX *ctx,
    int (*cb)(SSL *, int *, void *));
/**
 * @brief Set the user argument passed to all SRP callbacks on a context (deprecated).
 * @param ctx SSL context whose SRP callbacks receive @p arg.
 * @param arg Opaque pointer forwarded as the callback @c arg parameter.
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0 int SSL_CTX_set_srp_cb_arg(SSL_CTX *ctx, void *arg);

/**
 * @brief Set SRP group parameters, salt, verifier, and info on a server connection (deprecated).
 * @param s Server SSL connection that receives the SRP parameters.
 * @param N SRP prime modulus, or NULL to leave unchanged.
 * @param g SRP generator, or NULL to leave unchanged.
 * @param sa Salt value (ownership may transfer / be duplicated into the connection).
 * @param v Password verifier (ownership may transfer / be duplicated into the connection).
 * @param info Optional user-info string, or NULL.
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0
int SSL_set_srp_server_param(SSL *s, const BIGNUM *N, const BIGNUM *g,
    BIGNUM *sa, BIGNUM *v, char *info);
/**
 * @brief Set SRP server parameters for @p s from a username, password, and group id (deprecated).
 * @param s SSL connection that receives the generated salt and verifier.
 * @param user SRP username.
 * @param pass Password used to derive the verifier.
 * @param grp SRP group-parameter identifier for SRP_get_default_gN.
 * @return 1 on success, or a non-positive value on failure.
 */
OSSL_DEPRECATEDIN_3_0
int SSL_set_srp_server_param_pw(SSL *s, const char *user, const char *pass,
    const char *grp);

/**
 * @brief Return the SRP generator configured on a connection (deprecated).
 * @param s SSL connection with SRP parameters set.
 * @return Pointer to the SRP generator BIGNUM, or NULL if unset; do not free.
 */
OSSL_DEPRECATEDIN_3_0 __owur BIGNUM *SSL_get_srp_g(SSL *s);
/**
 * @brief Return the SRP prime N configured on a connection (deprecated).
