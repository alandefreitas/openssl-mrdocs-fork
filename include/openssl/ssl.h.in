 * @return Pointer to the SRP prime BIGNUM, or NULL if unset; do not free.
 */
OSSL_DEPRECATEDIN_3_0 __owur BIGNUM *SSL_get_srp_N(SSL *s);

/**
 * @brief Return the SRP username associated with a connection (deprecated).
 * @param s SSL connection that negotiated or configured SRP.
 * @return Username string owned by the library, or NULL if unset.
 */
OSSL_DEPRECATEDIN_3_0 __owur char *SSL_get_srp_username(SSL *s);
/**
 * @brief Return the optional SRP user-info string for a connection (deprecated).
 * @param s SSL connection that has SRP user info configured.
 * @return User-info string owned by the library, or NULL if unset.
 */
OSSL_DEPRECATEDIN_3_0 __owur char *SSL_get_srp_userinfo(SSL *s);
#endif
#endif

/*
 * ClientHello callback and helpers.
 */

#define SSL_CLIENT_HELLO_SUCCESS 1
#define SSL_CLIENT_HELLO_ERROR 0
#define SSL_CLIENT_HELLO_RETRY (-1)

/**
 * @brief Server callback invoked after a ClientHello is received and parsed.
 * @param s Server SSL connection processing the ClientHello.
 * @param al On failure, set to a TLS alert description to send.
 * @param arg Application pointer from SSL_CTX_set_client_hello_cb().
 * @return SSL_CLIENT_HELLO_SUCCESS, SSL_CLIENT_HELLO_ERROR, or SSL_CLIENT_HELLO_RETRY.
 */
typedef int (*SSL_client_hello_cb_fn)(SSL *s, int *al, void *arg);
/**
 * @brief Install a server callback invoked after each ClientHello is parsed.
 * @param c Server SSL context that receives ClientHellos.
 * @param cb Callback of type SSL_client_hello_cb_fn, or NULL to clear.
 * @param arg Application pointer forwarded to @p cb.
 */
void SSL_CTX_set_client_hello_cb(SSL_CTX *c, SSL_client_hello_cb_fn cb,
    void *arg);
/**
 * @brief Report whether the ClientHello being processed used the SSLv2 wire format.
 * @param s Server SSL connection inside a ClientHello callback (or with a parsed ClientHello).
 * @return 1 if the ClientHello is SSLv2-format, or 0 otherwise.
 */
int SSL_client_hello_isv2(SSL *s);
/**
 * @brief Return the legacy_version field from the ClientHello being processed.
 * @param s Server SSL connection inside a ClientHello callback (or with a parsed ClientHello).
 * @return Protocol version from the ClientHello legacy_version field, or 0 if unavailable.
 */
unsigned int SSL_client_hello_get0_legacy_version(SSL *s);
/**
 * @brief Return the ClientHello Random field from a client-hello callback context.
 * @param s SSL object during a client-hello callback.
 * @param out Receives a pointer to the random bytes (typically 32 bytes); do not free.
 * @return Number of random bytes, or 0 if unavailable.
 */
size_t SSL_client_hello_get0_random(SSL *s, const unsigned char **out);
/**
 * @brief Return the session_id field from the ClientHello being processed.
 * @param s SSL object during a client-hello callback.
 * @param out Receives a pointer to the session id octets; do not free.
 * @return Length of the session id in bytes, or 0 if unavailable.
 */
size_t SSL_client_hello_get0_session_id(SSL *s, const unsigned char **out);
/**
 * @brief Return the cipher_suites field from the ClientHello being processed.
 * @param s Server SSL connection inside a ClientHello callback (or with a parsed ClientHello).
 * @param out If non-NULL, set to point at the cipher suite list octets (do not free).
 * @return Length of the cipher_suites field in bytes, or 0 if unavailable.
 */
size_t SSL_client_hello_get0_ciphers(SSL *s, const unsigned char **out);
/**
 * @brief Return the raw compression_methods field from a parsed ClientHello.
 * @param s Server SSL connection inside a ClientHello callback (or with a parsed ClientHello).
 * @param out If non-NULL, set to point at the compression methods bytes.
 * @return Length of the compression_methods field in bytes, or 0 if unavailable.
 */
size_t SSL_client_hello_get0_compression_methods(SSL *s,
    const unsigned char **out);
/**
 * @brief Allocate and return the list of extension types present in a ClientHello.
 * @param s Server SSL connection inside a ClientHello callback (or with a parsed ClientHello).
 * @param out Receives a newly allocated array of extension type integers; free with OPENSSL_free.
 * @param outlen Receives the number of entries in *@p out.
 * @return 1 on success, or 0 on failure.
 */
int SSL_client_hello_get1_extensions_present(SSL *s, int **out, size_t *outlen);
/**
 * @brief Copy ClientHello extension type values in the order they appeared.
 * @param s Server SSL connection inside a ClientHello callback (or with a parsed ClientHello).
 * @param exts Buffer that receives ExtensionType values, or NULL to query the required count only.
 * @param num_exts On input, capacity of @p exts when non-NULL; on output, the number of extensions.
 * @return 1 on success, or 0 on failure (including when @p exts is too small).
 */
int SSL_client_hello_get_extension_order(SSL *s, uint16_t *exts,
    size_t *num_exts);
/**
 * @brief Return a pointer to a specific extension's payload in a parsed ClientHello.
 * @param s Server SSL connection inside a ClientHello callback (or with a parsed ClientHello).
 * @param type TLS extension type to look up.
 * @param out Set to the extension payload bytes (excluding type/length headers).
 * @param outlen Receives the payload length in bytes.
 * @return 1 if the extension is present, or 0 otherwise.
 */
int SSL_client_hello_get0_ext(SSL *s, unsigned int type,
    const unsigned char **out, size_t *outlen);

/**
 * @brief Clear certificates and related chain material configured on an SSL connection.
 * @param s SSL connection whose certificate configuration is reset (for example from a cert callback).
 */
void SSL_certs_clear(SSL *s);
/**
 * @brief Decrement the reference count of an SSL connection and free it when it reaches zero.
 * @param ssl SSL object to release, or NULL (no-op).
 */
void SSL_free(SSL *ssl);
#ifdef OSSL_ASYNC_FD
/*
 * Windows application developer has to include windows.h to use these.
 */
/**
 * @brief Report whether an SSL connection is paused waiting for an async crypto job.
 * @param s SSL connection using SSL_MODE_ASYNC.
 * @return 1 if waiting for async completion, or 0 otherwise.
 */
__owur int SSL_waiting_for_async(SSL *s);
/**
 * @brief Retrieve every file descriptor an async SSL operation is waiting on.
 * @param s SSL connection waiting for async completion.
 * @param fds Buffer receiving wait fds, or NULL to only query the required count.
 * @param numfds On entry, capacity of @p fds when non-NULL; on exit, number of fds.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_get_all_async_fds(SSL *s, OSSL_ASYNC_FD *fds, size_t *numfds);
/**
 * @brief Retrieve async wait fds added or removed since the previous query.
 * @param s SSL connection waiting for async completion.
 * @param addfd Buffer for newly added fds, or NULL to only query counts.
 * @param numaddfds On entry/exit, capacity and count for @p addfd.
 * @param delfd Buffer for removed fds, or NULL to only query counts.
 * @param numdelfds On entry/exit, capacity and count for @p delfd.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_get_changed_async_fds(SSL *s, OSSL_ASYNC_FD *addfd,
    size_t *numaddfds, OSSL_ASYNC_FD *delfd,
    size_t *numdelfds);
/**
 * @brief Set the asynchronous completion callback inherited by SSL objects from a context.
 * @param ctx SSL context whose default async callback is installed.
 * @param callback Function invoked when an async-capable engine finishes a crypto operation (with SSL_MODE_ASYNC).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_async_callback(SSL_CTX *ctx, SSL_async_callback_fn callback);
/**
 * @brief Set the user argument passed to the context's asynchronous completion callback.
 * @param ctx SSL context whose async callback receives @p arg.
 * @param arg Pointer forwarded to the async callback when a crypto operation completes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_async_callback_arg(SSL_CTX *ctx, void *arg);
/**
 * @brief Set the asynchronous completion callback on an SSL connection.
 * @param s SSL connection that uses SSL_MODE_ASYNC with an async-capable engine.
 * @param callback Function invoked when the engine finishes a crypto operation so the app can resume work.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_async_callback(SSL *s, SSL_async_callback_fn callback);
/**
 * @brief Set the user argument passed to an SSL object's asynchronous completion callback.
 * @param s SSL connection that uses SSL_MODE_ASYNC with an async-capable engine.
 * @param arg Pointer forwarded to the async callback when a crypto operation completes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_async_callback_arg(SSL *s, void *arg);
/**
 * @brief Query the current asynchronous operation status for an SSL connection.
 * @param s SSL connection used with SSL_MODE_ASYNC.
 * @param status Receives an ASYNC_* status code describing wait or completion state.
 * @return 1 on success, or 0 on failure.
 */
/**
 * @brief Query the current asynchronous operation status for an SSL connection.
 * @param s SSL connection used with SSL_MODE_ASYNC.
 * @param status Receives an ASYNC_* status code describing wait or completion state.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_get_async_status(SSL *s, int *status);

#endif
/**
 * @brief Wait for a TLS/SSL client to initiate the handshake on a server connection.
 * @param ssl Server SSL object with an underlying BIO (or equivalent) already set.
 * @return 1 if the handshake completed, 0 if it failed cleanly, or <0 on want-IO / fatal error (see SSL_get_error).
 */
__owur int SSL_accept(SSL *ssl);
/**
 * @brief Attempt a stateless (cookie) DTLS listen / HelloVerifyRequest exchange.
 * @param s DTLS server SSL object with a ClientHello ready to process.
 * @return 1 if a complete ClientHello with valid cookie was received, 0 if a
 *         HelloVerifyRequest was sent, or -1 on error.
 */
__owur int SSL_stateless(SSL *s);
/**
 * @brief Initiate the TLS/SSL handshake as a client on an already configured connection.
 * @param ssl Client SSL object with an underlying BIO (or equivalent) already set.
 * @return 1 if the handshake completed, 0 if it failed cleanly, or <0 on want-IO / fatal error (see SSL_get_error).
 */
__owur int SSL_connect(SSL *ssl);
/**
 * @brief Read application data from a TLS/SSL connection into a buffer.
 * @param ssl SSL connection to read from.
 * @param buf Destination buffer for plaintext.
 * @param num Maximum number of bytes to read into @p buf.
 * @return Number of bytes read (>0), 0 on clean shutdown / failure, or <0 on want-IO / error (see SSL_get_error).
 */
__owur int SSL_read(SSL *ssl, void *buf, int num);
/**
 * @brief Read application data from a TLS/SSL connection, reporting the byte count via an out parameter.
 * @param ssl SSL connection to read from.
 * @param buf Destination buffer for plaintext.
 * @param num Maximum number of bytes to read into @p buf.
 * @param readbytes On success, receives the number of bytes actually read.
 * @return 1 on success, or 0 on failure / want-IO (see SSL_get_error).
 */
__owur int SSL_read_ex(SSL *ssl, void *buf, size_t num, size_t *readbytes);

#define SSL_READ_EARLY_DATA_ERROR 0
#define SSL_READ_EARLY_DATA_SUCCESS 1
#define SSL_READ_EARLY_DATA_FINISH 2

/**
 * @brief Read TLSv1.3 early data on a server connection (must be the first I/O call).
 * @param s Server SSL connection with early data enabled.
 * @param buf Destination buffer for early-data plaintext.
 * @param num Maximum number of bytes to read into @p buf.
 * @param readbytes On SSL_READ_EARLY_DATA_SUCCESS, receives the number of bytes read.
 * @return SSL_READ_EARLY_DATA_SUCCESS, SSL_READ_EARLY_DATA_FINISH, or SSL_READ_EARLY_DATA_ERROR.
 */
__owur int SSL_read_early_data(SSL *s, void *buf, size_t num,
    size_t *readbytes);
/**
 * @brief Copy up to @p num pending application bytes without consuming them.
 * @param ssl SSL connection.
 * @param buf Destination buffer.
 * @param num Maximum number of bytes to copy.
 * @return Number of bytes copied, 0 on EOF, or a negative value on error.
 */
__owur int SSL_peek(SSL *ssl, void *buf, int num);
/**
 * @brief Peek at application data from an SSL/TLS connection without consuming it.
 * @param ssl SSL connection to read from.
 * @param buf Destination buffer for plaintext.
 * @param num Maximum number of bytes to copy into @p buf.
 * @param readbytes On success, receives the number of bytes peeked.
 * @return 1 on success, or 0 on failure / want-IO (identical to SSL_read_ex except bytes remain buffered).
 */
__owur int SSL_peek_ex(SSL *ssl, void *buf, size_t num, size_t *readbytes);
/**
 * @brief Send file contents over TLS using kernel sendfile where available.
 * @param s SSL connection to write to.
 * @param fd Open file descriptor positioned / addressed by @p offset.
 * @param offset Starting file offset.
 * @param size Maximum number of bytes to send.
 * @param flags Implementation-specific flags (typically 0).
 * @return Number of bytes written, or a negative value on error / want-IO.
 */
__owur ossl_ssize_t SSL_sendfile(SSL *s, int fd, off_t offset, size_t size,
    int flags);
/**
 * @brief Write application data from a buffer to a TLS/SSL connection.
 * @param ssl SSL connection to write to.
 * @param buf Source buffer of plaintext to encrypt and send.
 * @param num Number of bytes from @p buf to write.
 * @return Number of bytes written (>0), 0 on failure, or <0 on want-IO / error (see SSL_get_error).
 */
__owur int SSL_write(SSL *ssl, const void *buf, int num);
/**
 * @brief Write application data from a buffer to a TLS/SSL connection (size_t length).
 * @param s SSL connection to write to.
 * @param buf Source buffer of plaintext to encrypt and send.
 * @param num Number of bytes from @p buf to write.
 * @param written On success, receives the number of bytes written.
 * @return 1 on success, or 0 on failure / want-IO (see SSL_get_error).
 */
__owur int SSL_write_ex(SSL *s, const void *buf, size_t num, size_t *written);
/**
 * @brief Write early data (0-RTT) on a client SSL connection before the handshake completes.
 * @param s Client SSL connection that may send early data.
 * @param buf Plaintext to send as early data.
 * @param num Number of bytes from @p buf to write.
 * @param written Receives the number of bytes accepted on success.
 * @return 1 on success, or 0 on failure / want-IO (see SSL_get_error).
 */
__owur int SSL_write_early_data(SSL *s, const void *buf, size_t num,
    size_t *written);
/**
 * @brief Perform a low-level control operation on an SSL connection (prefer typed helpers/macros).
 * @param ssl SSL connection to manipulate.
 * @param cmd Control command (SSL_CTRL_* or DTLS_CTRL_*).
 * @param larg Integer / size argument whose meaning depends on @p cmd.
 * @param parg Pointer argument whose meaning depends on @p cmd.
 * @return Command-specific long result; see the corresponding SSL_CTRL_* helper documentation.
 */
long SSL_ctrl(SSL *ssl, int cmd, long larg, void *parg);
/**
 * @brief Perform a low-level control operation that takes a function-pointer argument on an SSL connection.
 * @param ssl SSL connection to manipulate.
 * @param cmd Control command that expects a callback (see SSL_CTRL_* helpers).
 * @param fp Callback pointer whose type and meaning depend on @p cmd.
 * @return Command-specific long result; prefer typed helpers over calling this directly.
 */
long SSL_callback_ctrl(SSL *ssl, int cmd, void (*fp)(void));
/**
 * @brief Perform a low-level control operation on an SSL context.
 * @param ctx SSL context to manipulate.
 * @param cmd Control command (SSL_CTRL_*); prefer typed SSL_CTX_* helpers.
 * @param larg Integer argument whose meaning depends on @p cmd.
 * @param parg Pointer argument whose meaning depends on @p cmd.
 * @return Command-specific long result.
 */
long SSL_CTX_ctrl(SSL_CTX *ctx, int cmd, long larg, void *parg);
/**
 * @brief Perform a low-level control operation that takes a function-pointer argument on an SSL context.
 * @param ctx SSL context to manipulate.
 * @param cmd Control command that expects a callback (see SSL_CTRL_* helpers).
 * @param fp Callback pointer whose type and meaning depend on @p cmd.
 * @return Command-specific long result; prefer typed helpers over calling this directly.
 */
long SSL_CTX_callback_ctrl(SSL_CTX *ctx, int cmd, void (*fp)(void));

#define SSL_WRITE_FLAG_CONCLUDE (1U << 0)

/**
 * @brief Write application data to a TLS/SSL/QUIC connection with extended write flags.
 * @param s SSL connection to write to.
 * @param buf Source buffer of plaintext to encrypt and send.
 * @param num Number of bytes from @p buf to write.
 * @param flags Write flags such as SSL_WRITE_FLAG_CONCLUDE.
 * @param written On success, receives the number of bytes written.
 * @return 1 on success, or 0 on failure / want-IO (see SSL_get_error).
 */
__owur int SSL_write_ex2(SSL *s, const void *buf, size_t num,
    uint64_t flags,
    size_t *written);

#define SSL_EARLY_DATA_NOT_SENT 0
#define SSL_EARLY_DATA_REJECTED 1
#define SSL_EARLY_DATA_ACCEPTED 2

/**
 * @brief Report whether early data was accepted, rejected, or never sent on a connection.
 * @param s SSL connection after early-data / handshake processing.
 * @return SSL_EARLY_DATA_ACCEPTED, SSL_EARLY_DATA_REJECTED, or SSL_EARLY_DATA_NOT_SENT.
 */
__owur int SSL_get_early_data_status(const SSL *s);

/**
 * @brief Map a TLS/SSL I/O return value to a detailed error / retry code.
 * @param s SSL connection on which the I/O call was made.
 * @param ret_code Return value from SSL_read, SSL_write, SSL_do_handshake, SSL_accept, SSL_connect, or SSL_shutdown.
 * @return SSL_ERROR_NONE, SSL_ERROR_ZERO_RETURN, SSL_ERROR_WANT_READ/WRITE, SSL_ERROR_SYSCALL, SSL_ERROR_SSL, or another SSL_ERROR_* code.
 */
__owur int SSL_get_error(const SSL *s, int ret_code);
/**
 * @brief Return the protocol version name negotiated on a connection.
 * @param s SSL connection to query.
 * @return Static string such as "TLSv1.3", or "unknown" when no version is available.
 */
__owur const char *SSL_get_version(const SSL *s);
/**
 * @brief Return the measured TLS handshake round-trip time in microseconds when available.
 * @param s SSL connection to query.
 * @param rtt Receives the RTT in microseconds.
 * @return 1 if an RTT measurement is available, or 0 / a negative value otherwise.
 */
__owur int SSL_get_handshake_rtt(const SSL *s, uint64_t *rtt);

/* This sets the 'default' SSL version that SSL_new() will create */
#ifndef OPENSSL_NO_DEPRECATED_3_0
/**
 * @brief Replace the SSL_METHOD used by an SSL_CTX (deprecated).
 * @param ctx SSL context whose default method is updated.
 * @param meth New connection method such as TLS_method().
 * @return 1 on success, or 0 on failure.
 */
OSSL_DEPRECATEDIN_3_0
__owur int SSL_CTX_set_ssl_version(SSL_CTX *ctx, const SSL_METHOD *meth);
