 * @return Pointer to the static TLSv1.0 SSL_METHOD for use with SSL_CTX_new.
 */
OSSL_DEPRECATEDIN_1_1_0 __owur const SSL_METHOD *TLSv1_method(void); /* TLSv1.0 */
