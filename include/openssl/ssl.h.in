/**
 * @brief Return a client-or-server SSL_METHOD that negotiates DTLS 1.0 or 1.2.
 * @return Pointer to the static DTLS SSL_METHOD for use with SSL_CTX_new.
 */
__owur const SSL_METHOD *DTLS_method(void); /* DTLS 1.0 and 1.2 */
/**
 * @brief Return a server-only SSL_METHOD that negotiates DTLS 1.0 or 1.2.
 * @return Pointer to the static DTLS server SSL_METHOD for use with SSL_CTX_new.
 */
__owur const SSL_METHOD *DTLS_server_method(void); /* DTLS 1.0 and 1.2 */
/**
 * @brief Return a client-only SSL_METHOD negotiating DTLSv1.0 or DTLSv1.2.
 * @return Pointer to a static SSL_METHOD.
 */
__owur const SSL_METHOD *DTLS_client_method(void); /* DTLS 1.0 and 1.2 */

/**
 * @brief Return the maximum application-data payload size for a DTLS connection.
 * @param s DTLS SSL object whose path MTU / record overhead are considered.
 * @return Maximum bytes of application data per datagram, or 0 if unknown.
 */
__owur size_t DTLS_get_data_mtu(const SSL *s);

/**
 * @brief Return the preference-ordered stack of ciphers available on an SSL connection.
 * @param s SSL connection to query.
 * @return Stack of SSL_CIPHER objects, or NULL if none; do not free.
 */
__owur STACK_OF(SSL_CIPHER) *SSL_get_ciphers(const SSL *s);
/**
 * @brief Return the preference-ordered stack of ciphers configured on an SSL context.
 * @param ctx SSL context to query.
 * @return Stack of SSL_CIPHER objects, or NULL if none; do not free.
 */
__owur STACK_OF(SSL_CIPHER) *SSL_CTX_get_ciphers(const SSL_CTX *ctx);
/**
 * @brief Return the stack of ciphers offered by the client (server-side only).
 * @param s Server SSL connection that has received a ClientHello.
 * @return Stack of matching SSL_CIPHER objects, or NULL if not in server mode / unavailable; do not free.
 */
__owur STACK_OF(SSL_CIPHER) *SSL_get_client_ciphers(const SSL *s);
/**
 * @brief Return the preference-ordered stack of enabled ciphers that would be sent in a ClientHello.
 * @param s SSL connection to query; list depends on cipher list, protocol versions, security level, and signature algorithms.
 * @return Newly allocated stack of SSL_CIPHER objects (free with sk_SSL_CIPHER_free), or NULL if @p s is NULL / none available.
 */
__owur STACK_OF(SSL_CIPHER) *SSL_get1_supported_ciphers(SSL *s);

/**
 * @brief Drive the TLS/SSL handshake to completion on a connection already set to connect or accept state.
 * @param s SSL connection whose handshake should progress (client starts the handshake when in connect state).
 * @return 1 if the handshake completed, 0 if it failed cleanly, or <0 on want-IO / fatal error (see SSL_get_error).
 */
__owur int SSL_do_handshake(SSL *s);
/**
 * @brief Schedule a TLS 1.3 / QUIC key update of the requested type on @p s.
 * @param s SSL connection that has negotiated TLSv1.3 (or QUIC).
 * @param updatetype SSL_KEY_UPDATE_REQUESTED or SSL_KEY_UPDATE_NOT_REQUESTED.
 * @return 1 on success, or 0 on error.
 */
int SSL_key_update(SSL *s, int updatetype);
/**
 * @brief Return the type of any pending TLS 1.3 / QUIC key update that has not yet been sent.
 * @param s SSL connection to query.
 * @return SSL_KEY_UPDATE_REQUESTED, SSL_KEY_UPDATE_NOT_REQUESTED, or SSL_KEY_UPDATE_NONE if none is pending.
 */
int SSL_get_key_update_type(const SSL *s);
/**
 * @brief Schedule a full renegotiation of the current TLS ≤ 1.2 connection.
 * @param s SSL connection that has negotiated TLSv1.2 or earlier.
 * @return 1 on success, or 0 on error.
 */
/**
 * @brief Schedule a full renegotiation of the current TLS ≤ 1.2 connection.
 * @param s SSL connection that has negotiated TLSv1.2 or earlier.
 * @return 1 on success, or 0 on error.
 */
int SSL_renegotiate(SSL *s);
/**
 * @brief Schedule a renegotiation that attempts to resume the current session (TLS ≤ 1.2).
 * @param s SSL connection that has negotiated TLSv1.2 or earlier; on the client, session resumption is attempted.
 * @return 1 on success, or 0 on error.
 */
int SSL_renegotiate_abbreviated(SSL *s);
/**
 * @brief Test whether a renegotiation (or renegotiation request) is scheduled but not yet performed.
 * @param s SSL connection to query.
 * @return 1 if a renegotiation is pending, or 0 otherwise.
 */
__owur int SSL_renegotiate_pending(const SSL *s);
/**
 * @brief Queue generation of a new TLSv1.3 NewSessionTicket message on a server connection.
 * @param s Server SSL connection that negotiated TLSv1.3.
 * @return 1 if a ticket was scheduled, or 0 on failure.
 *
 * The ticket is written during a subsequent write/handshake call once pending records allow it.
 */
int SSL_new_session_ticket(SSL *s);
/**
 * @brief Shut down an active TLS/DTLS or QUIC connection (close_notify / connection close).
 * @param s SSL connection to shut down; do not call after a prior fatal SSL_ERROR_SYSCALL or SSL_ERROR_SSL.
 * @return 1 when the shutdown has completed, 0 if it is in progress (e.g. nonblocking), or a negative value on error.
 */
int SSL_shutdown(SSL *s);
/**
 * @brief Request TLSv1.3 post-handshake client authentication from a server SSL.
 * @param s Server SSL connection that negotiated TLSv1.3 with a client that advertised PHA support.
 * @return 1 if a CertificateRequest was queued successfully, or 0 on failure.
 */
__owur int SSL_verify_client_post_handshake(SSL *s);
/**
 * @brief Enable or disable sending the TLSv1.3 Post-Handshake Authentication ClientHello extension.
 * @param ctx Client SSL context; non-zero @p val includes the extension so the server may request PHA.
 * @param val Non-zero to advertise post-handshake authentication support; 0 to omit the extension (default).
 */
void SSL_CTX_set_post_handshake_auth(SSL_CTX *ctx, int val);
/**
 * @brief Enable or disable TLSv1.3 post-handshake authentication on a connection.
 * @param s SSL connection to configure.
 * @param val Non-zero to allow post-handshake CertificateRequest, or 0 to disable.
 */
void SSL_set_post_handshake_auth(SSL *s, int val);

/**
 * @brief Return the SSL_METHOD used to create an SSL context.
 * @param ctx SSL context to query.
 * @return Pointer to the context's SSL_METHOD.
 */
__owur const SSL_METHOD *SSL_CTX_get_ssl_method(const SSL_CTX *ctx);
/**
 * @brief Return the SSL_METHOD currently associated with an SSL connection.
 * @param s SSL connection to query.
 * @return Pointer to the connection's SSL_METHOD.
 */
__owur const SSL_METHOD *SSL_get_ssl_method(const SSL *s);
/**
 * @brief Replace the TLS/SSL method used by an existing SSL connection.
 * @param s SSL connection whose method is updated (may reset on SSL_clear; cannot switch QUIC ↔ non-QUIC).
 * @param method New SSL_METHOD; see SSL_CTX_new for available choices.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_ssl_method(SSL *s, const SSL_METHOD *method);
/**
 * @brief Return a long human-readable description of a TLS/SSL alert type.
 * @param value Alert type value (for example from an info callback's ret argument).
 * @return NUL-terminated string such as "warning" or "fatal" (static storage).
 */
__owur const char *SSL_alert_type_string_long(int value);
/**
 * @brief Return a short string for an SSL/TLS alert level.
 * @param value Alert description encoded as in the TLS Alert protocol (level in the high bits as used by OpenSSL callbacks).
 * @return "W" (warning), "F" (fatal), or "U" (unknown); do not free.
 */
__owur const char *SSL_alert_type_string(int value);
/**
 * @brief Return a long human-readable description of a TLS/SSL alert reason code.
 * @param value Alert description value (for example from an info callback).
 * @return NUL-terminated string naming the alert reason (static storage).
 */
__owur const char *SSL_alert_desc_string_long(int value);
/**
 * @brief Return a short letter code for a TLS/SSL alert description.
 * @param value Alert description value (for example from an info callback).
 * @return NUL-terminated short string such as "CN" or "UK" (static storage).
 */
__owur const char *SSL_alert_desc_string(int value);

/**
 * @brief Set the list of CA names sent to the peer on this connection (takes ownership).
 * @param s SSL connection whose certificate_authorities / CA list overrides the parent context.
 * @param name_list Stack of X509_NAME subjects; ownership transfers to @p s (do not free).
 */
void SSL_set0_CA_list(SSL *s, STACK_OF(X509_NAME) *name_list);
/**
 * @brief Set the list of CA names sent to the peer for an SSL context (takes ownership).
 * @param ctx SSL context whose certificate_authorities / CA list is replaced.
 * @param name_list Stack of X509_NAME subjects; ownership transfers to @p ctx (do not free).
 */
void SSL_CTX_set0_CA_list(SSL_CTX *ctx, STACK_OF(X509_NAME) *name_list);
/**
 * @brief Return the list of CA names configured to be sent to the peer.
 * @param s SSL connection to query; falls back to the parent SSL_CTX list if unset.
 * @return Stack of X509_NAME subjects, or an empty/NULL list; do not free.
 */
__owur const STACK_OF(X509_NAME) *SSL_get0_CA_list(const SSL *s);
/**
 * @brief Return the list of CA names the context will advertise to peers.
 * @param ctx SSL context to query.
 * @return Internal stack of X509_NAME (do not free), or NULL if unset.
 */
__owur const STACK_OF(X509_NAME) *SSL_CTX_get0_CA_list(const SSL_CTX *ctx);
/**
 * @brief Append a CA subject name from a certificate to this connection's peer CA list.
 * @param ssl SSL connection whose CA list overrides the parent context.
 * @param x Certificate whose subject name is duplicated onto the list.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_add1_to_CA_list(SSL *ssl, const X509 *x);
/**
 * @brief Append a CA subject name from a certificate to an SSL context's peer CA list.
 * @param ctx SSL context whose CA list is updated.
 * @param x Certificate whose subject name is duplicated onto the list.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_add1_to_CA_list(SSL_CTX *ctx, const X509 *x);
/**
 * @brief Return the list of CA names the peer advertised for client authentication.
 * @param s SSL connection to query (typically on the client after CertificateRequest).
 * @return Internal STACK_OF(X509_NAME) (do not free), or NULL if none was received.
 */
__owur const STACK_OF(X509_NAME) *SSL_get0_peer_CA_list(const SSL *s);

/**
 * @brief Set the list of CA names sent when requesting a client certificate on a connection.
 * @param s Server SSL connection that owns @p name_list after this call (overrides the parent context list).
 * @param name_list Stack of X509_NAME objects identifying acceptable CAs; ownership transfers to @p s.
 */
void SSL_set_client_CA_list(SSL *s, STACK_OF(X509_NAME) *name_list);
/**
 * @brief Set the list of CA names sent to clients when requesting a client certificate.
 * @param ctx SSL context (typically a server) that owns @p name_list after this call.
 * @param name_list Stack of X509_NAME objects identifying acceptable CAs; ownership transfers to @p ctx.
 */
/**
 * @brief Set the list of CA names sent to clients when requesting a client certificate.
 * @param ctx SSL context (typically a server) that owns @p name_list after this call.
 * @param name_list Stack of X509_NAME objects identifying acceptable CAs; ownership transfers to @p ctx.
 */
void SSL_CTX_set_client_CA_list(SSL_CTX *ctx, STACK_OF(X509_NAME) *name_list);
/**
 * @brief Return the CA names offered for client authentication on this connection.
 * @param s SSL connection to query (typically a client that received CertificateRequest).
 * @return Stack of X509_NAME objects (do not free), or NULL if none are available.
 */
__owur STACK_OF(X509_NAME) *SSL_get_client_CA_list(const SSL *s);
/**
 * @brief Return the stack of CA names the context will send when requesting a client certificate.
 * @param s SSL context to query.
 * @return Stack of X509_NAME objects (do not free), or NULL if none are configured.
 */
__owur STACK_OF(X509_NAME) *SSL_CTX_get_client_CA_list(const SSL_CTX *s);
/**
 * @brief Add a CA subject name to the client-CA list sent when requesting a client certificate.
 * @param ssl Server SSL connection whose client-CA list overrides the parent context.
 * @param x Certificate whose subject name is appended (not taken ownership of).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_add_client_CA(SSL *ssl, X509 *x);
/**
 * @brief Add a CA subject name to the context's client-CA list sent when requesting a client certificate.
 * @param ctx Server SSL context whose client-CA list is extended (created if none was set).
 * @param x Certificate whose subject name is appended (not taken ownership of).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_add_client_CA(SSL_CTX *ctx, X509 *x);

/**
 * @brief Configure an SSL object to operate as a TLS client.
 * @param s SSL connection that will initiate the handshake as a client.
 */
void SSL_set_connect_state(SSL *s);
/**
 * @brief Configure an SSL object to behave as a server (accept) endpoint.
 * @param s SSL connection that will perform the server role in the handshake.
 */
void SSL_set_accept_state(SSL *s);

/**
 * @brief Return the default session timeout for the protocol negotiated on a connection.
 * @param s SSL connection whose protocol determines the default timeout.
 * @return Default timeout in seconds assigned to new SSL_SESSION objects for that protocol.
 */
__owur long SSL_get_default_timeout(const SSL *s);

#ifndef OPENSSL_NO_DEPRECATED_1_1_0
#define SSL_library_init() OPENSSL_init_ssl(0, NULL)
#endif

/**
 * @brief Write a human-readable description of a cipher suite into a buffer.
 * @param cipher Cipher suite to describe.
 * @param buf Destination buffer of at least 128 bytes, or NULL to allocate with OPENSSL_malloc (caller frees).
 * @param size Capacity of @p buf in bytes when @p buf is non-NULL.
 * @return Pointer to the NUL-terminated description (possibly newly allocated), or NULL on error / undersized buffer.
 */
__owur char *SSL_CIPHER_description(const SSL_CIPHER *cipher, char *buf, int size);
/**
 * @brief Deep-copy a stack of CA subject names.
 * @param sk Source STACK_OF(X509_NAME), or NULL.
 * @return Newly allocated duplicate stack, or NULL on failure / when @p sk is NULL.
 */
__owur STACK_OF(X509_NAME) *SSL_dup_CA_list(const STACK_OF(X509_NAME) *sk);

/**
 * @brief Duplicate an SSL object that is still in its initial (pre-handshake) state.
 * @param ssl SSL connection to copy; must not have started the handshake (else refcount is bumped instead).
 * @return New SSL with a subset of @p ssl's settings copied, the same handle if already active, or NULL on error / QUIC.
 */
__owur SSL *SSL_dup(SSL *ssl);

/**
 * @brief Return the local certificate selected (or most recently set) for a connection.
 * @param ssl SSL connection to query.
 * @return X509 identity certificate, or NULL if none is configured / selected; do not free.
 */
__owur X509 *SSL_get_certificate(const SSL *ssl);
/*
 * EVP_PKEY
 */
/**
 * @brief Return the local private key configured on @p ssl (borrowed pointer).
 * @param ssl SSL connection.
 * @return EVP_PKEY used for the local certificate, or NULL if unset.
 */
struct evp_pkey_st *SSL_get_privatekey(const SSL *ssl);

/**
 * @brief Return the local certificate configured on an SSL context (if any).
 * @param ctx SSL context to query.
 * @return X509 for the context's local identity, or NULL; do not free.
 */
__owur X509 *SSL_CTX_get0_certificate(const SSL_CTX *ctx);
/**
 * @brief Return the private key configured on an SSL context (if any).
 * @param ctx SSL context to query.
 * @return EVP_PKEY for the context's local identity, or NULL; do not free.
 */
__owur EVP_PKEY *SSL_CTX_get0_privatekey(const SSL_CTX *ctx);

/**
 * @brief Set quiet-shutdown mode for SSL objects created from a context.
 * @param ctx SSL context whose default quiet-shutdown flag is set.
 * @param mode Non-zero to skip sending/receiving close_notify, or 0 for normal shutdown.
 */
void SSL_CTX_set_quiet_shutdown(SSL_CTX *ctx, int mode);
/**
 * @brief Return the quiet-shutdown setting of an SSL context.
 * @param ctx SSL context to query.
 * @return 1 if quiet shutdown is enabled (skip close_notify), or 0 for standard shutdown.
 */
__owur int SSL_CTX_get_quiet_shutdown(const SSL_CTX *ctx);
/**
 * @brief Enable or disable quiet shutdown (skip sending close_notify) on a connection.
 * @param ssl SSL connection whose quiet-shutdown flag is set (no effect on QUIC).
 * @param mode 1 to treat SSL_shutdown as already bidirectional without an alert; 0 for standard close_notify.
 */
void SSL_set_quiet_shutdown(SSL *ssl, int mode);
/**
 * @brief Return whether quiet-shutdown mode is enabled on an SSL connection.
 * @param ssl SSL connection to query.
 * @return Non-zero if quiet shutdown is set, or 0 for a normal bidirectional close.
 */
__owur int SSL_get_quiet_shutdown(const SSL *ssl);
/**
 * @brief Set the shutdown state bit-mask on an SSL connection.
 * @param ssl SSL connection whose shutdown flags are replaced.
 * @param mode Bit-mask of SSL_SENT_SHUTDOWN and/or SSL_RECEIVED_SHUTDOWN (or 0 to clear).
 */
void SSL_set_shutdown(SSL *ssl, int mode);
/**
 * @brief Return the shutdown state bit-mask of an SSL connection.
 * @param ssl SSL connection to query.
 * @return Bit-mask of SSL_SENT_SHUTDOWN and/or SSL_RECEIVED_SHUTDOWN, or 0 if neither is set.
 */
__owur int SSL_get_shutdown(const SSL *ssl);
/**
 * @brief Return the numeric protocol version negotiated on a connection.
 * @param ssl SSL connection to query (results are reliable after the initial handshake).
 * @return Protocol version constant such as TLS1_3_VERSION, DTLS1_2_VERSION, or OSSL_QUIC1_VERSION.
 */
__owur int SSL_version(const SSL *ssl);
/**
 * @brief Return the numeric protocol version advertised by the client in ClientHello.
 * @param s SSL connection to query.
 * @return Legacy ClientHello version (never greater than TLSv1.2 for TLS), or OSSL_QUIC1_VERSION for QUIC.
 */
__owur int SSL_client_version(const SSL *s);
/**
 * @brief Load the default CA file, directory, and store into an SSL context's trust store.
 * @param ctx SSL context whose verification locations are set to the OpenSSL defaults (or SSL_CERT_* env overrides).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_default_verify_paths(SSL_CTX *ctx);
/**
 * @brief Load only the default hashed CA directory into an SSL context's trust store.
 * @param ctx SSL context that receives the default certs directory (or SSL_CERT_DIR).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_default_verify_dir(SSL_CTX *ctx);
/**
 * @brief Load only the default CA certificate file into an SSL context's trust store.
 * @param ctx SSL context that receives the default certs file (or SSL_CERT_FILE).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_default_verify_file(SSL_CTX *ctx);
/**
 * @brief Load the default trusted certificate store into an SSL context.
 * @param ctx SSL context whose verification store is populated from system defaults.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_default_verify_store(SSL_CTX *ctx);
/**
 * @brief Load trusted CA certificates from a PEM file into an SSL context.
 * @param ctx SSL context whose verification store is updated.
 * @param CAfile Path to a PEM file containing one or more CA certificates.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_load_verify_file(SSL_CTX *ctx, const char *CAfile);
/**
 * @brief Load trusted CA certificates from a hashed directory into an SSL context.
 * @param ctx SSL context whose verification store is updated.
 * @param CApath Directory of PEM certificates named by subject-name hash (see SSL_CTX_load_verify_locations).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_load_verify_dir(SSL_CTX *ctx, const char *CApath);
/**
 * @brief Load trusted CA certificates from a store URI into an SSL context.
 * @param ctx SSL context whose verification store is updated.
 * @param CAstore URI of a certificate store (single container or catalogue).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_load_verify_store(SSL_CTX *ctx, const char *CAstore);
/**
 * @brief Load trusted CA certificates from a PEM file and/or hashed directory into an SSL context.
 * @param ctx SSL context whose verification store is updated.
 * @param CAfile Path to a PEM file of CA certificates, or NULL to skip.
 * @param CApath Directory of PEM certificates named by subject-name hash, or NULL to skip.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_load_verify_locations(SSL_CTX *ctx,
    const char *CAfile,
    const char *CApath);
#define SSL_get0_session SSL_get_session /* just peek at pointer */
/**
 * @brief Return the SSL_SESSION currently associated with a connection (no reference bump).
 * @param ssl SSL connection to query.
 * @return Pointer to the session in use, or NULL; may become invalid after SSL_clear/SSL_free or cache flush.
 */
__owur SSL_SESSION *SSL_get_session(const SSL *ssl);
/**
 * @brief Return the current SSL_SESSION for @p ssl with an incremented reference count.
 * @param ssl SSL connection to query.
 * @return SSL_SESSION (caller must SSL_SESSION_free()), or NULL if none is available.
 */
__owur SSL_SESSION *SSL_get1_session(SSL *ssl); /* obtain a reference count */
/**
 * @brief Return the SSL_CTX from which an SSL connection was created.
 * @param ssl SSL connection to query.
 * @return Pointer to the creating SSL_CTX.
 */
__owur SSL_CTX *SSL_get_SSL_CTX(const SSL *ssl);
/**
 * @brief Replace the SSL_CTX associated with an existing SSL connection object.
 * @param ssl SSL object whose context is changed.
 * @param ctx New SSL_CTX to associate; certificates and some settings are inherited.
 * @return Previous SSL_CTX associated with @p ssl.
 */
SSL_CTX *SSL_set_SSL_CTX(SSL *ssl, SSL_CTX *ctx);
/**
 * @brief Set the information callback used to observe state changes, alerts, and errors on a connection.
 * @param ssl SSL connection whose info callback is replaced.
 * @param cb Callback invoked with SSL_CB_* @p type and @p val during handshake and I/O; NULL restores the SSL_CTX callback.
 */
void SSL_set_info_callback(SSL *ssl,
    void (*cb)(const SSL *ssl, int type, int val));
/**
 * @brief Return the info callback previously set on an SSL with SSL_set_info_callback().
 * @param ssl SSL object to query.
 * @return Callback pointer, or NULL if unset.
 */
void (*SSL_get_info_callback(const SSL *ssl))(const SSL *ssl, int type,
    int val);
/**
 * @brief Return the current TLS/DTLS/QUIC handshake state enumeration for @p ssl.
 * @param ssl SSL connection to query.
 * @return OSSL_HANDSHAKE_STATE value describing where the handshake state machine is.
 */
__owur OSSL_HANDSHAKE_STATE SSL_get_state(const SSL *ssl);

/**
 * @brief Override the stored peer-certificate verification result on a connection.
 * @param ssl SSL connection whose verify result is replaced (not persisted into a reusable session).
 * @param v X509_V_* result code (see openssl-verify); typically X509_V_OK or an error code.
 */
void SSL_set_verify_result(SSL *ssl, long v);
/**
 * @brief Return the result code from verifying the peer's X509 certificate.
 * @param ssl SSL connection whose peer verification outcome is queried.
 * @return X509_V_OK if verification succeeded or no peer certificate was presented; otherwise an X509_V_* error.
 */
__owur long SSL_get_verify_result(const SSL *ssl);
/**
 * @brief Return the verified peer certificate chain including the end-entity certificate.
 * @param s SSL connection after a successful session establishment.
 * @return Stack of X509 (do not free), possibly incomplete if verification failed; NULL if unavailable.
 */
__owur STACK_OF(X509) *SSL_get0_verified_chain(const SSL *s);

/**
 * @brief Copy the TLS ClientHello random value from a connection.
 * @param ssl SSL connection whose client_random is requested.
 * @param out Destination buffer, or NULL to query the required length only.
 * @param outlen Capacity of @p out in bytes.
 * @return Number of bytes available / copied (typically SSL3_RANDOM_SIZE).
 */
__owur size_t SSL_get_client_random(const SSL *ssl, unsigned char *out,
    size_t outlen);
/**
 * @brief Copy the TLS server random value from an SSL connection into a buffer.
 * @param ssl SSL connection after the ServerHello has been processed.
 * @param out Buffer that receives up to @p outlen bytes; ignored if @p outlen is 0.
 * @param outlen Capacity of @p out, or 0 to query the random length only.
 * @return Number of bytes copied, or the full server-random length when @p outlen is 0.
 */
__owur size_t SSL_get_server_random(const SSL *ssl, unsigned char *out,
    size_t outlen);
/**
 * @brief Copy the session master secret into a caller buffer (sensitive; avoid exposing).
 * @param sess Session whose master key is read.
 * @param out Buffer that receives up to @p outlen bytes of the master secret; ignored if @p outlen is 0.
 * @param outlen Capacity of @p out, or 0 to query the master-secret length only.
 * @return Number of bytes copied, or the full master-secret length when @p outlen is 0.
 */
__owur size_t SSL_SESSION_get_master_key(const SSL_SESSION *sess,
    unsigned char *out, size_t outlen);
/**
 * @brief Set the master secret on an SSL session by copying @p in.
 * @param sess Session whose master key is replaced.
 * @param in Master secret octets.
 * @param len Length of @p in in bytes (must be acceptable for the protocol).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_SESSION_set1_master_key(SSL_SESSION *sess,
    const unsigned char *in, size_t len);
/**
 * @brief Return the Maximum Fragment Length extension mode negotiated for a session.
 * @param sess SSL session to query.
 * @return One of TLSEXT_max_fragment_length_* (including TLSEXT_max_fragment_length_DISABLED when unset or unsupported).
 */
uint8_t SSL_SESSION_get_max_fragment_length(const SSL_SESSION *sess);

#define SSL_get_ex_new_index(l, p, newf, dupf, freef) \
    CRYPTO_get_ex_new_index(CRYPTO_EX_INDEX_SSL, l, p, newf, dupf, freef)
/**
 * @brief Store application-specific data on an SSL connection at an ex_data index.
 * @param ssl SSL connection that owns the ex_data slot.
 * @param idx Index from SSL_get_ex_new_index (or a related allocator).
 * @param data Opaque pointer to store; may be NULL.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_ex_data(SSL *ssl, int idx, void *data);
/**
 * @brief Retrieve application-specific data previously stored on an SSL object.
 * @param ssl SSL connection to query.
 * @param idx Index returned by SSL_get_ex_new_index / CRYPTO_get_ex_new_index.
 * @return Pointer previously passed to SSL_set_ex_data, or NULL.
 */
void *SSL_get_ex_data(const SSL *ssl, int idx);
#define SSL_SESSION_get_ex_new_index(l, p, newf, dupf, freef) \
    CRYPTO_get_ex_new_index(CRYPTO_EX_INDEX_SSL_SESSION, l, p, newf, dupf, freef)
/**
 * @brief Store application data on an SSL_SESSION at a CRYPTO_EX index.
 * @param ss Session object to update.
 * @param idx Index from SSL_SESSION_get_ex_new_index().
 * @param data Application pointer to store (may be NULL).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_SESSION_set_ex_data(SSL_SESSION *ss, int idx, void *data);
/**
 * @brief Retrieve application data previously stored on an SSL_SESSION.
 * @param ss Session to query.
 * @param idx Index from CRYPTO_get_ex_new_index() / SSL_SESSION_get_ex_new_index().
 * @return Stored pointer, or NULL if unset.
 */
void *SSL_SESSION_get_ex_data(const SSL_SESSION *ss, int idx);
#define SSL_CTX_get_ex_new_index(l, p, newf, dupf, freef) \
    CRYPTO_get_ex_new_index(CRYPTO_EX_INDEX_SSL_CTX, l, p, newf, dupf, freef)
/**
 * @brief Store application-specific data on an SSL_CTX at a previously allocated index.
 * @param ssl SSL context that owns the ex_data table.
 * @param idx Index from SSL_CTX_get_ex_new_index() (or CRYPTO_get_ex_new_index).
 * @param data Pointer to store; ownership remains with the caller unless freef was configured.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set_ex_data(SSL_CTX *ssl, int idx, void *data);
/**
 * @brief Retrieve application-specific data previously stored on an SSL_CTX.
 * @param ssl SSL_CTX that owns the ex_data table.
 * @param idx Index from SSL_CTX_get_ex_new_index().
 * @return Stored pointer, or NULL if unset.
 */
void *SSL_CTX_get_ex_data(const SSL_CTX *ssl, int idx);

/**
 * @brief Return the ex_data index used to retrieve the SSL pointer from an X509_STORE_CTX.
 * @return Fixed index for X509_STORE_CTX_get_ex_data during certificate verify callbacks.
 */
__owur int SSL_get_ex_data_X509_STORE_CTX_idx(void);

#define SSL_CTX_sess_set_cache_size(ctx, t) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_SESS_CACHE_SIZE, t, NULL)
#define SSL_CTX_sess_get_cache_size(ctx) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_GET_SESS_CACHE_SIZE, 0, NULL)
#define SSL_CTX_set_session_cache_mode(ctx, m) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_SESS_CACHE_MODE, m, NULL)
#define SSL_CTX_get_session_cache_mode(ctx) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_GET_SESS_CACHE_MODE, 0, NULL)

#define SSL_CTX_get_default_read_ahead(ctx) SSL_CTX_get_read_ahead(ctx)
#define SSL_CTX_set_default_read_ahead(ctx, m) SSL_CTX_set_read_ahead(ctx, m)
#define SSL_CTX_get_read_ahead(ctx) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_GET_READ_AHEAD, 0, NULL)
#define SSL_CTX_set_read_ahead(ctx, m) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_READ_AHEAD, m, NULL)
#define SSL_CTX_get_max_cert_list(ctx) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_GET_MAX_CERT_LIST, 0, NULL)
#define SSL_CTX_set_max_cert_list(ctx, m) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MAX_CERT_LIST, m, NULL)
#define SSL_get_max_cert_list(ssl) \
    SSL_ctrl(ssl, SSL_CTRL_GET_MAX_CERT_LIST, 0, NULL)
#define SSL_set_max_cert_list(ssl, m) \
    SSL_ctrl(ssl, SSL_CTRL_SET_MAX_CERT_LIST, m, NULL)

#define SSL_CTX_set_max_send_fragment(ctx, m) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MAX_SEND_FRAGMENT, m, NULL)
#define SSL_set_max_send_fragment(ssl, m) \
    SSL_ctrl(ssl, SSL_CTRL_SET_MAX_SEND_FRAGMENT, m, NULL)
#define SSL_CTX_set_split_send_fragment(ctx, m) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_SPLIT_SEND_FRAGMENT, m, NULL)
#define SSL_set_split_send_fragment(ssl, m) \
    SSL_ctrl(ssl, SSL_CTRL_SET_SPLIT_SEND_FRAGMENT, m, NULL)
#define SSL_CTX_set_max_pipelines(ctx, m) \
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MAX_PIPELINES, m, NULL)
#define SSL_set_max_pipelines(ssl, m) \
    SSL_ctrl(ssl, SSL_CTRL_SET_MAX_PIPELINES, m, NULL)
#define SSL_set_retry_verify(ssl) \
    (SSL_ctrl(ssl, SSL_CTRL_SET_RETRY_VERIFY, 0, NULL) > 0)

/**
 * @brief Set the default read-buffer size used for new connections from a context (pipelining).
 * @param ctx SSL context whose default read buffer length is updated.
 * @param len Desired buffer size in bytes; applied only when larger than the normal default (at least 16704).
 */
void SSL_CTX_set_default_read_buffer_len(SSL_CTX *ctx, size_t len);
/**
 * @brief Set the default read-buffer size used for pipelined reads on a connection.
 * @param s SSL connection whose read buffer length is updated.
 * @param len Desired buffer size in bytes; applied only when larger than the normal default (at least 16704).
 */
void SSL_set_default_read_buffer_len(SSL *s, size_t len);

#ifndef OPENSSL_NO_DH
#ifndef OPENSSL_NO_DEPRECATED_3_0
/* NB: the |keylength| is only applicable when is_export is true */
/**
 * @brief Set a deprecated callback that supplies ephemeral DH parameters for server connections from a context.
 * @param ctx SSL context that invokes @p dh when temporary DH parameters are needed.
 * @param dh Callback returning a DH object owned by the application (@p is_export / @p keylength are unused on modern OpenSSL).
 */
OSSL_DEPRECATEDIN_3_0
void SSL_CTX_set_tmp_dh_callback(SSL_CTX *ctx,
    DH *(*dh)(SSL *ssl, int is_export,
        int keylength));
/**
 * @brief Set a deprecated callback that supplies ephemeral DH parameters for a server connection.
 * @param ssl Server SSL connection that invokes @p dh when temporary DH parameters are needed.
 * @param dh Callback returning a DH object owned by the application (@p is_export / @p keylength are unused on modern OpenSSL).
 */
OSSL_DEPRECATEDIN_3_0
void SSL_set_tmp_dh_callback(SSL *ssl,
    DH *(*dh)(SSL *ssl, int is_export,
        int keylength));
#endif
#endif

/**
 * @brief Return the compression method negotiated for sending on a connection.
 * @param s SSL connection to query.
 * @return COMP_METHOD in use for compression, or NULL if compression is inactive / unavailable.
 */
__owur const COMP_METHOD *SSL_get_current_compression(const SSL *s);
/**
 * @brief Return the compression method used for expanding (decompressing) received records.
 * @param s SSL connection to query.
 * @return COMP_METHOD in use for expansion, or NULL if compression is inactive / unavailable.
 */
__owur const COMP_METHOD *SSL_get_current_expansion(const SSL *s);
/**
 * @brief Return the display name of a compression COMP_METHOD.
 * @param comp Compression method, or NULL.
 * @return Static name string, or NULL when @p comp is NULL / unnamed.
 */
__owur const char *SSL_COMP_get_name(const COMP_METHOD *comp);
/**
 * @brief Return the name of an SSL_COMP compression method entry.
 * @param comp Compression method descriptor from the global method list.
 * @return Static name string for @p comp.
 */
__owur const char *SSL_COMP_get0_name(const SSL_COMP *comp);
/**
 * @brief Return the wire identifier of an SSL_COMP compression method entry.
 * @param comp Compression method descriptor from the global method list.
 * @return Integer compression method id.
 */
__owur int SSL_COMP_get_id(const SSL_COMP *comp);
/**
 * @brief Return the global stack of available SSL/TLS integrated compression methods.
 * @return Internal STACK_OF(SSL_COMP) of compression methods, or NULL on error.
 */
STACK_OF(SSL_COMP) *SSL_COMP_get_compression_methods(void);
/**
 * @brief Replace the global stack of SSL/TLS compression methods, transferring ownership of @p meths.
 * @param meths New STACK_OF(SSL_COMP) to install, or NULL to clear.
 * @return Previous compression-method stack (caller may free), or NULL if none was set.
 */
__owur STACK_OF(SSL_COMP) *SSL_COMP_set0_compression_methods(STACK_OF(SSL_COMP)
        *meths);
#ifndef OPENSSL_NO_DEPRECATED_1_1_0
#define SSL_COMP_free_compression_methods() \
    while (0)                               \
    continue
#endif
/**
 * @brief Register a compression method globally for all SSL operations in the process.
 * @param id Wire identifier advertised for @p cm (must be unique among enabled methods).
 * @param cm COMP_METHOD implementation to add to the global list.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_COMP_add_compression_method(int id, COMP_METHOD *cm);

/**
 * @brief Look up a cipher suite by its two-byte TLS cipher ID.
 * @param ssl SSL object used to resolve the ID against known suites (may be unused by the implementation).
 * @param ptr Two-byte cipher ID in network byte order (for example from SSL_client_hello_get0_ciphers).
 * @return Matching SSL_CIPHER, or NULL if not found or on error.
 */
const SSL_CIPHER *SSL_CIPHER_find(SSL *ssl, const unsigned char *ptr);
/**
 * @brief Return the NID of the bulk cipher algorithm used by a cipher suite.
 * @param c Cipher suite to query.
 * @return Cipher NID, or NID_undef when the suite has no encryption.
 */
int SSL_CIPHER_get_cipher_nid(const SSL_CIPHER *c);
/**
 * @brief Return the NID of the MAC digest used by a cipher for record protection.
 * @param c Cipher suite to query.
 * @return Digest NID, or NID_undef when the suite has no MAC (for example AEAD suites).
 */
int SSL_CIPHER_get_digest_nid(const SSL_CIPHER *c);
/**
 * @brief Parse a wire-format cipher suite list into SSL_CIPHER and SCSV stacks.
 * @param s SSL object used to resolve suite IDs against the library's known ciphers.
 * @param bytes Wire encoding of cipher suites (2 octets each for TLS, or 3 for SSLv2 format).
 * @param len Length of @p bytes.
 * @param isv2format Non-zero if @p bytes uses the three-octet SSLv2 cipher format.
 * @param sk On success, receives a new stack of supported SSL_CIPHER objects (caller frees).
 * @param scsvs On success, receives a new stack of signalling cipher suite values (caller frees).
 * @return 1 on success, or 0 on failure; unsupported suites are ignored.
 */
int SSL_bytes_to_cipher_list(SSL *s, const unsigned char *bytes, size_t len,
    int isv2format, STACK_OF(SSL_CIPHER) **sk,
    STACK_OF(SSL_CIPHER) **scsvs);

/* TLS extensions functions */
/**
 * @brief Attach opaque session-ticket extension data to a client SSL connection.
 * @param s Client SSL connection that will send the ticket extension.
 * @param ext_data Extension payload bytes, or NULL to clear.
 * @param ext_len Length of @p ext_data in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_session_ticket_ext(SSL *s, void *ext_data, int ext_len);

/**
 * @brief Install a callback that processes the TLS session-ticket extension on an SSL.
 * @param s SSL connection.
 * @param cb Callback invoked with ticket extension data, or NULL to clear.
 * @param arg Opaque pointer passed to @p cb.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_session_ticket_ext_cb(SSL *s,
    tls_session_ticket_ext_cb_fn cb,
    void *arg);

/* Pre-shared secret session resumption functions */
/**
 * @brief Install an EAP-FAST session-secret callback that supplies the TLS master secret.
 * @param s SSL connection that invokes @p session_secret_cb during the handshake (EAP-FAST only).
 * @param session_secret_cb Callback that fills the master secret (and optionally selects a cipher); NULL to clear.
 * @param arg Opaque pointer passed through to @p session_secret_cb.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_session_secret_cb(SSL *s,
    tls_session_secret_cb_fn session_secret_cb,
    void *arg);

/**
 * @brief Register a context-wide callback that decides whether new sessions may be resumed.
 * @param ctx SSL context whose sessions inherit this policy (copied to new SSL objects by SSL_new).
 * @param cb Callback returning non-zero to mark the session non-resumable; @p is_forward_secure indicates forward secrecy.
 */
/**
 * @brief Register a context-wide callback that decides whether new sessions may be resumed.
 * @param ctx SSL context whose sessions inherit this policy (copied to new SSL objects by SSL_new).
 * @param cb Callback returning non-zero to mark the session non-resumable; @p is_forward_secure indicates forward secrecy.
 */
void SSL_CTX_set_not_resumable_session_callback(SSL_CTX *ctx,
    int (*cb)(SSL *ssl,
        int
            is_forward_secure));

/**
 * @brief Register a callback that decides whether a session may be resumed.
 * @param ssl SSL connection that will invoke the callback when creating sessions.
 * @param cb Callback returning non-zero to mark the session non-resumable; @p is_forward_secure indicates forward secrecy.
 */
void SSL_set_not_resumable_session_callback(SSL *ssl,
    int (*cb)(SSL *ssl,
        int is_forward_secure));

/**
 * @brief Install a callback that chooses TLS 1.3 record padding for connections from a context.
 * @param ctx SSL context whose padding callback is set (copied to new SSL objects by SSL_new).
 * @param cb Callback receiving record @p type and plaintext @p len; returns padding bytes to add (0 for none), or NULL to clear.
 */
void SSL_CTX_set_record_padding_callback(SSL_CTX *ctx,
    size_t (*cb)(SSL *ssl, int type,
        size_t len, void *arg));
/**
 * @brief Set the opaque argument passed to the context's TLS 1.3 record-padding callback.
 * @param ctx SSL context whose padding callback argument is set (inherited by SSL_new).
 * @param arg Pointer forwarded as the callback's @c arg parameter, or NULL.
 */
/**
 * @brief Set the opaque argument passed to the context's TLS 1.3 record-padding callback.
 * @param ctx SSL context whose padding callback argument is set (inherited by SSL_new).
 * @param arg Pointer forwarded as the callback's @c arg parameter, or NULL.
 */
void SSL_CTX_set_record_padding_callback_arg(SSL_CTX *ctx, void *arg);
/**
 * @brief Return the opaque argument passed to the context's TLS 1.3 record-padding callback.
 * @param ctx SSL context to query.
 * @return Pointer previously set via SSL_CTX_set_record_padding_callback_arg, or NULL.
 */
void *SSL_CTX_get_record_padding_callback_arg(const SSL_CTX *ctx);
/**
 * @brief Pad TLS 1.3 records written from a context up to a multiple of a block size.
 * @param ctx SSL context whose default block padding is set (copied to new SSL objects).
 * @param block_size Padding multiple; 0 or 1 disables block padding (max SSL3_RT_MAX_PLAIN_LENGTH).
 * @return 1 on success, or 0 on failure.
 */
int SSL_CTX_set_block_padding(SSL_CTX *ctx, size_t block_size);

/**
 * @brief Install a TLS 1.3 record-padding callback on a connection.
 * @param ssl SSL connection whose outbound records may be padded.
 * @param cb Callback returning extra padding length for a record of content type @c type and plaintext length @c len; may be NULL to clear.
 * @return 1 on success, or 0 on failure.
 */
int SSL_set_record_padding_callback(SSL *ssl,
    size_t (*cb)(SSL *ssl, int type,
        size_t len, void *arg));
/**
 * @brief Set the opaque argument passed to a connection's TLS 1.3 record-padding callback.
 * @param ssl SSL connection whose padding callback receives @p arg.
 * @param arg Application pointer forwarded to the callback; may be NULL.
 */
void SSL_set_record_padding_callback_arg(SSL *ssl, void *arg);
/**
 * @brief Return the opaque argument passed to a connection's TLS 1.3 record-padding callback.
 * @param ssl SSL connection to query.
 * @return Pointer previously set via SSL_set_record_padding_callback_arg, or NULL.
 */
void *SSL_get_record_padding_callback_arg(const SSL *ssl);
/**
 * @brief Pad TLS 1.3 application records for @p ssl to a multiple of @p block_size.
 * @param ssl SSL object to configure (not supported for QUIC).
 * @param block_size Padding block size; 0 or 1 disables block padding; must not exceed SSL3_RT_MAX_PLAIN_LENGTH.
 * @return 1 on success, or 0 if @p block_size is too large or the call is invalid for @p ssl.
 */
int SSL_set_block_padding(SSL *ssl, size_t block_size);

/**
 * @brief Set how many NewSessionTicket messages a TLSv1.3 server connection should send.
 * @param s Server SSL connection to configure.
 * @param num_tickets Number of tickets to send after the handshake (0 disables tickets).
 * @return 1 on success, or 0 on failure.
 */
int SSL_set_num_tickets(SSL *s, size_t num_tickets);
/**
 * @brief Return how many TLSv1.3 session tickets a server connection will send after a full handshake.
 * @param s SSL connection to query.
 * @return Configured ticket count (default 2); resumption issues at most one regardless.
 */
size_t SSL_get_num_tickets(const SSL *s);
/**
 * @brief Set how many TLSv1.3 session tickets servers created from a context send after a full handshake.
 * @param ctx Server SSL context whose default ticket count is set (typically before the handshake).
 * @param num_tickets Number of tickets to send; 0 disables tickets (resumption still issues at most one if non-zero).
 * @return 1 on success, or 0 on failure.
 */
int SSL_CTX_set_num_tickets(SSL_CTX *ctx, size_t num_tickets);
/**
 * @brief Return how many TLSv1.3 session tickets servers from a context are configured to send.
 * @param ctx SSL context previously configured with SSL_CTX_set_num_tickets(), or the default of 2.
 * @return Configured ticket count.
 */
size_t SSL_CTX_get_num_tickets(const SSL_CTX *ctx);

/* QUIC support */
/**
 * @brief Advance an SSL object's event state (DTLS timers, QUIC event loop helper).
 * @param s SSL connection that may have pending timeout or I/O events.
 * @return 1 on success, or 0 on failure.
 */
int SSL_handle_events(SSL *s);
/**
 * @brief Report when an SSL object next needs timer-driven processing (DTLS/QUIC).
 * @param s SSL connection to query; non-DTLS/non-QUIC objects report an infinite timeout.
 * @param tv On success with a finite timeout, receives the relative time until SSL_handle_events should run (zero if due now).
 * @param is_infinite Set to 1 when no timer is pending (@p tv unspecified), or 0 when @p tv is valid.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_get_event_timeout(SSL *s, struct timeval *tv, int *is_infinite);
/**
 * @brief Fill @p desc with the poll descriptor used to wait for readable SSL/QUIC data.
 * @param s SSL (or QUIC) connection.
 * @param desc Receives the BIO_POLL_DESCRIPTOR for the read side.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_get_rpoll_descriptor(SSL *s, BIO_POLL_DESCRIPTOR *desc);
/**
 * @brief Obtain a poll descriptor indicating when the SSL object can usefully write to the network.
 * @param s SSL connection (QUIC or with configured write BIO) to query.
 * @param desc On success, receives a BIO_POLL_DESCRIPTOR for writability (see BIO_get_wpoll_descriptor).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_get_wpoll_descriptor(SSL *s, BIO_POLL_DESCRIPTOR *desc);
/**
 * @brief Report whether the SSL object wants to read from the network BIO.
 * @param s SSL connection (typically QUIC or non-blocking DTLS/TLS).
 * @return 1 if a network read should be attempted, or 0 otherwise.
 */
__owur int SSL_net_read_desired(SSL *s);
/**
 * @brief Report whether the SSL object wants to write to the network BIO.
 * @param s SSL connection (typically QUIC or non-blocking DTLS/TLS).
 * @return 1 if a network write should be attempted, or 0 otherwise.
 */
__owur int SSL_net_write_desired(SSL *s);
/**
 * @brief Enable or disable blocking mode on a QUIC connection SSL object.
 * @param s QUIC connection SSL object to configure.
 * @param blocking 1 to block in SSL_read/SSL_write until the operation can complete, or 0 for nonblocking.
 * @return 1 on success, or 0 if @p s is not a QUIC connection or blocking mode cannot be used.
 */
__owur int SSL_set_blocking_mode(SSL *s, int blocking);
/**
 * @brief Return whether a QUIC connection SSL object is in blocking mode.
 * @param s SSL object to query; must be a QUIC connection.
 * @return 1 if blocking, 0 if non-blocking, or -1 if @p s is not a QUIC connection.
 */
__owur int SSL_get_blocking_mode(SSL *s);
/**
 * @brief Set the initial UDP peer address used to establish a QUIC client connection.
 * @param s QUIC connection SSL object, before the first connection attempt.
 * @param peer_addr Destination BIO_ADDR of the server; copied by this call.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set1_initial_peer_addr(SSL *s, const BIO_ADDR *peer_addr);
/**
 * @brief Return the QUIC connection SSL for a stream, or @p s itself for connection / non-QUIC objects.
 * @param s QUIC stream, QUIC connection, or non-QUIC SSL object.
 * @return Owning QUIC connection SSL, or @p s when already a connection / non-QUIC; never NULL.
 */
__owur SSL *SSL_get0_connection(SSL *s);
/**
 * @brief Test whether an SSL object is a connection (or non-QUIC) rather than a QUIC stream.
 * @param s SSL object to classify.
 * @return 1 for QUIC connection and non-QUIC SSL objects, or 0 for QUIC stream SSL objects.
 */
__owur int SSL_is_connection(SSL *s);

#define SSL_STREAM_TYPE_NONE 0
#define SSL_STREAM_TYPE_READ (1U << 0)
#define SSL_STREAM_TYPE_WRITE (1U << 1)
#define SSL_STREAM_TYPE_BIDI (SSL_STREAM_TYPE_READ | SSL_STREAM_TYPE_WRITE)
/**
 * @brief Return the QUIC stream type of an SSL connection or stream object.
 * @param s SSL object representing a QUIC connection or stream.
 * @return SSL_STREAM_TYPE_* constant describing bidirectional/uni/none behaviour.
 */
__owur int SSL_get_stream_type(SSL *s);

/**
 * @brief Return the QUIC stream ID for a stream SSL, or for a connection with a default stream.
 * @param s QUIC stream SSL or QUIC connection SSL that has a default stream attached.
 * @return Stream identifier, or 0 when not applicable.
 */
__owur uint64_t SSL_get_stream_id(SSL *s);
/**
 * @brief Test whether a QUIC stream SSL object was created locally (client-initiated locally).
 * @param s SSL object representing a QUIC stream.
 * @return 1 if the stream is locally initiated, 0 if remote, or a negative value on error.
 */
__owur int SSL_is_stream_local(SSL *s);

#define SSL_DEFAULT_STREAM_MODE_NONE 0
#define SSL_DEFAULT_STREAM_MODE_AUTO_BIDI 1
#define SSL_DEFAULT_STREAM_MODE_AUTO_UNI 2
/**
 * @brief Configure how the default QUIC stream behaves for an SSL connection.
 * @param s QUIC SSL connection to configure.
 * @param mode SSL_DEFAULT_STREAM_MODE_* constant controlling default-stream creation.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_default_stream_mode(SSL *s, uint32_t mode);

#define SSL_STREAM_FLAG_UNI (1U << 0)
#define SSL_STREAM_FLAG_NO_BLOCK (1U << 1)
#define SSL_STREAM_FLAG_ADVANCE (1U << 2)
/**
 * @brief Create a new locally initiated QUIC stream on a QUIC connection.
 * @param s QUIC connection SSL object.
 * @param flags Bitwise OR of SSL_STREAM_FLAG_UNI, SSL_STREAM_FLAG_NO_BLOCK, and/or SSL_STREAM_FLAG_ADVANCE.
 * @return New QUIC stream SSL object (caller frees with SSL_free), or NULL on failure.
 */
__owur SSL *SSL_new_stream(SSL *s, uint64_t flags);

#define SSL_INCOMING_STREAM_POLICY_AUTO 0
#define SSL_INCOMING_STREAM_POLICY_ACCEPT 1
#define SSL_INCOMING_STREAM_POLICY_REJECT 2
/**
 * @brief Configure whether a QUIC connection automatically accepts or rejects peer-initiated streams.
 * @param s QUIC connection SSL object.
 * @param policy SSL_INCOMING_STREAM_POLICY_AUTO, _ACCEPT, or _REJECT.
 * @param aec Application error code used in STOP_SENDING/RESET_STREAM when rejecting (default 0).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set_incoming_stream_policy(SSL *s, int policy, uint64_t aec);

#define SSL_ACCEPT_STREAM_NO_BLOCK (1U << 0)
/**
 * @brief Dequeue an incoming remotely initiated QUIC stream from a connection.
 * @param s QUIC connection SSL object (may wait in blocking mode unless SSL_ACCEPT_STREAM_NO_BLOCK).
 * @param flags Bitwise OR of SSL_ACCEPT_STREAM_* flags; SSL_ACCEPT_STREAM_NO_BLOCK never blocks.
 * @return New QUIC stream SSL (caller frees), or NULL if none are available / on error.
 */
__owur SSL *SSL_accept_stream(SSL *s, uint64_t flags);
/**
 * @brief Return how many incoming QUIC streams are waiting to be accepted.
 * @param s QUIC connection SSL object.
 * @return Number of remotely initiated streams currently queued for SSL_accept_stream().
 */
__owur size_t SSL_get_accept_stream_queue_len(SSL *s);

#ifndef OPENSSL_NO_QUIC
/**
 * @brief Inject a received UDP datagram into a QUIC SSL object's network BIO path.
 * @param s QUIC connection or listener SSL object.
 * @param buf Datagram payload bytes.
 * @param buf_len Length of @p buf.
 * @param peer Optional peer address associated with the datagram, or NULL.
 * @param local Optional local address associated with the datagram, or NULL.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_inject_net_dgram(SSL *s, const unsigned char *buf,
    size_t buf_len,
    const BIO_ADDR *peer,
    const BIO_ADDR *local);
#endif

/**
 * @brief Extended arguments for SSL_shutdown_ex() (currently QUIC-specific).
 */
typedef struct ssl_shutdown_ex_args_st {
    /**
     * @brief Optional QUIC application error code in [0, 2^62-1] signalled to the peer; defaults to 0.
     */
    uint64_t quic_error_code;
    /**
     * @brief Optional UTF-8 reason string for QUIC connection closure, or NULL.
     */
    const char *quic_reason;
} SSL_SHUTDOWN_EX_ARGS;

#define SSL_SHUTDOWN_FLAG_RAPID (1U << 0)
#define SSL_SHUTDOWN_FLAG_NO_STREAM_FLUSH (1U << 1)
#define SSL_SHUTDOWN_FLAG_NO_BLOCK (1U << 2)
#define SSL_SHUTDOWN_FLAG_WAIT_PEER (1U << 3)

/**
 * @brief Shut down a TLS/DTLS or QUIC connection with optional extended arguments.
 * @param ssl Connection to shut down.
 * @param flags Bitwise OR of SSL_SHUTDOWN_FLAG_* controlling blocking and QUIC behaviour.
 * @param args Optional SSL_SHUTDOWN_EX_ARGS (QUIC error code/reason), or NULL for defaults.
 * @param args_len Size of @p args when non-NULL; must be sizeof(SSL_SHUTDOWN_EX_ARGS).
 * @return 1 when shutdown is complete, 0 if it is in progress (retry), or <0 on error.
 *
 * For non-QUIC connections this matches SSL_shutdown() aside from @p flags.
 */
__owur int SSL_shutdown_ex(SSL *ssl, uint64_t flags,
    const SSL_SHUTDOWN_EX_ARGS *args,
    size_t args_len);

/**
 * @brief Signal normal end-of-stream on the sending part of a QUIC stream.
 * @param ssl QUIC stream SSL object, or a QUIC connection SSL with a default stream.
 * @param flags Reserved; must be 0.
 * @return 1 on success (including subsequent no-op calls), or 0 on failure.
 */
__owur int SSL_stream_conclude(SSL *ssl, uint64_t flags);

/**
 * @brief Arguments for SSL_stream_reset() describing how a QUIC stream is aborted.
 */
typedef struct ssl_stream_reset_args_st {
    /**
     * @brief Application error code in [0, 2^62-1] signalled with the RESET_STREAM; 0 if args is NULL.
     */
    uint64_t quic_error_code;
} SSL_STREAM_RESET_ARGS;

/**
 * @brief Reset a QUIC stream associated with @p ssl, optionally sending an app error code.
 * @param ssl SSL object representing the stream to reset.
 * @param args Optional reset arguments (application error code), or NULL.
 * @param args_len Size of @p args in bytes when non-NULL; use sizeof(*args).
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_stream_reset(SSL *ssl,
    const SSL_STREAM_RESET_ARGS *args,
    size_t args_len);

#define SSL_STREAM_STATE_NONE 0
#define SSL_STREAM_STATE_OK 1
#define SSL_STREAM_STATE_WRONG_DIR 2
#define SSL_STREAM_STATE_FINISHED 3
#define SSL_STREAM_STATE_RESET_LOCAL 4
#define SSL_STREAM_STATE_RESET_REMOTE 5
#define SSL_STREAM_STATE_CONN_CLOSED 6
/**
 * @brief Return the overall state of the receiving part of a QUIC stream.
 * @param ssl QUIC stream SSL object, or a QUIC connection SSL with a default stream.
 * @return One of SSL_STREAM_STATE_* (e.g. OK, FINISHED, RESET_LOCAL/REMOTE, CONN_CLOSED, NONE).
 */
__owur int SSL_get_stream_read_state(SSL *ssl);
/**
 * @brief Return the overall state of the sending part of a QUIC stream.
 * @param ssl QUIC stream SSL object, or a QUIC connection SSL with a default stream.
 * @return One of SSL_STREAM_STATE_* (e.g. OK, FINISHED, RESET_LOCAL/REMOTE, CONN_CLOSED, NONE).
 */
__owur int SSL_get_stream_write_state(SSL *ssl);

/**
 * @brief Get the application error code from a non-normal QUIC stream receive abort.
 * @param ssl QUIC stream SSL object, or a QUIC connection SSL with a default stream.
 * @param app_error_code On success, receives the signalled application error code.
 * @return 1 on success, 0 if the receive part terminated normally, or -1 on error
 *     (still healthy, wrong stream direction, non-QUIC, or no default stream).
 */
__owur int SSL_get_stream_read_error_code(SSL *ssl, uint64_t *app_error_code);
/**
 * @brief Get the application error code from a non-normal QUIC stream send abort.
 * @param ssl QUIC stream SSL object, or a QUIC connection SSL with a default stream.
 * @param app_error_code On success, receives the signalled application error code.
 * @return 1 on success, 0 if the send part terminated normally, or -1 on error
 *     (still healthy, wrong stream direction, non-QUIC, or no default stream).
 */
__owur int SSL_get_stream_write_error_code(SSL *ssl, uint64_t *app_error_code);

#define SSL_CONN_CLOSE_FLAG_LOCAL (1U << 0)
#define SSL_CONN_CLOSE_FLAG_TRANSPORT (1U << 1)

/**
 * @brief Information describing why and how a QUIC connection was closed.
 */
typedef struct ssl_conn_close_info_st {
    /**
     * @brief 62-bit QUIC application or transport error code (see @c flags).
     */
    uint64_t error_code;
    /**
     * @brief QUIC frame type that caused transport closure, or 0 if unspecified/not transport.
     */
    uint64_t frame_type;
    /**
     * @brief Optional zero-terminated reason string from the closer; treat as untrusted peer data.
     */
    const char *reason;
    /**
     * @brief Length of @c reason in bytes (preferred over relying on the terminator alone).
     */
    size_t reason_len;
    /**
     * @brief Bitmask of SSL_CONN_CLOSE_FLAG_* (local vs remote, transport vs application).
     */
    uint32_t flags;
} SSL_CONN_CLOSE_INFO;

/**
 * @brief Retrieve why a terminated QUIC connection was closed.
 * @param ssl QUIC connection SSL object that has already terminated.
 * @param info Output structure to fill; must be non-NULL.
 * @param info_len Size of @p info (must be sizeof(*info)).
 * @return 1 on success, or 0 on failure (e.g. not terminated, stream, or non-QUIC).
 */
__owur int SSL_get_conn_close_info(SSL *ssl,
    SSL_CONN_CLOSE_INFO *info,
    size_t info_len);

#define SSL_VALUE_CLASS_GENERIC 0
#define SSL_VALUE_CLASS_FEATURE_REQUEST 1
#define SSL_VALUE_CLASS_FEATURE_PEER_REQUEST 2
#define SSL_VALUE_CLASS_FEATURE_NEGOTIATED 3

#define SSL_VALUE_NONE 0
#define SSL_VALUE_QUIC_STREAM_BIDI_LOCAL_AVAIL 1
#define SSL_VALUE_QUIC_STREAM_BIDI_REMOTE_AVAIL 2
#define SSL_VALUE_QUIC_STREAM_UNI_LOCAL_AVAIL 3
#define SSL_VALUE_QUIC_STREAM_UNI_REMOTE_AVAIL 4
#define SSL_VALUE_QUIC_IDLE_TIMEOUT 5
#define SSL_VALUE_EVENT_HANDLING_MODE 6
#define SSL_VALUE_STREAM_WRITE_BUF_SIZE 7
#define SSL_VALUE_STREAM_WRITE_BUF_USED 8
#define SSL_VALUE_STREAM_WRITE_BUF_AVAIL 9

#define SSL_VALUE_EVENT_HANDLING_MODE_INHERIT 0
#define SSL_VALUE_EVENT_HANDLING_MODE_IMPLICIT 1
#define SSL_VALUE_EVENT_HANDLING_MODE_EXPLICIT 2

/**
 * @brief Read a uint64 feature/value identified by @p class_ / @p id from SSL @p s.
 * @param s SSL connection.
 * @param class_ Value class (SSL_VALUE_CLASS_*).
 * @param id Value identifier within @p class_ (SSL_VALUE_*).
 * @param v Receives the retrieved value on success.
 * @return 1 on success, or 0 on error / unsupported value.
 */
int SSL_get_value_uint(SSL *s, uint32_t class_, uint32_t id, uint64_t *v);
/**
 * @brief Set a configurable uint64 parameter on an SSL object (feature negotiation or generic).
 * @param s SSL connection or stream whose value is updated.
 * @param class_ Value class (SSL_VALUE_CLASS_GENERIC, FEATURE_REQUEST, etc.).
 * @param id Value identifier within @p class_ (SSL_VALUE_*).
 * @param v New value to set.
 * @return 1 on success, or 0 on failure.
 */
int SSL_set_value_uint(SSL *s, uint32_t class_, uint32_t id, uint64_t v);

#define SSL_get_generic_value_uint(ssl, id, v) \
    SSL_get_value_uint((ssl), SSL_VALUE_CLASS_GENERIC, (id), (v))
#define SSL_set_generic_value_uint(ssl, id, v) \
    SSL_set_value_uint((ssl), SSL_VALUE_CLASS_GENERIC, (id), (v))
#define SSL_get_feature_request_uint(ssl, id, v) \
    SSL_get_value_uint((ssl), SSL_VALUE_CLASS_FEATURE_REQUEST, (id), (v))
#define SSL_set_feature_request_uint(ssl, id, v) \
    SSL_set_value_uint((ssl), SSL_VALUE_CLASS_FEATURE_REQUEST, (id), (v))
#define SSL_get_feature_peer_request_uint(ssl, id, v) \
    SSL_get_value_uint((ssl), SSL_VALUE_CLASS_FEATURE_PEER_REQUEST, (id), (v))
#define SSL_get_feature_negotiated_uint(ssl, id, v) \
    SSL_get_value_uint((ssl), SSL_VALUE_CLASS_FEATURE_NEGOTIATED, (id), (v))

#define SSL_get_quic_stream_bidi_local_avail(ssl, value)                      \
    SSL_get_generic_value_uint((ssl), SSL_VALUE_QUIC_STREAM_BIDI_LOCAL_AVAIL, \
        (value))
#define SSL_get_quic_stream_bidi_remote_avail(ssl, value)                      \
    SSL_get_generic_value_uint((ssl), SSL_VALUE_QUIC_STREAM_BIDI_REMOTE_AVAIL, \
        (value))
#define SSL_get_quic_stream_uni_local_avail(ssl, value)                      \
    SSL_get_generic_value_uint((ssl), SSL_VALUE_QUIC_STREAM_UNI_LOCAL_AVAIL, \
        (value))
#define SSL_get_quic_stream_uni_remote_avail(ssl, value)                      \
    SSL_get_generic_value_uint((ssl), SSL_VALUE_QUIC_STREAM_UNI_REMOTE_AVAIL, \
        (value))

#define SSL_get_event_handling_mode(ssl, value)                      \
    SSL_get_generic_value_uint((ssl), SSL_VALUE_EVENT_HANDLING_MODE, \
        (value))
#define SSL_set_event_handling_mode(ssl, value)                      \
    SSL_set_generic_value_uint((ssl), SSL_VALUE_EVENT_HANDLING_MODE, \
        (value))

#define SSL_get_stream_write_buf_size(ssl, value)                      \
    SSL_get_generic_value_uint((ssl), SSL_VALUE_STREAM_WRITE_BUF_SIZE, \
        (value))
#define SSL_get_stream_write_buf_used(ssl, value)                      \
    SSL_get_generic_value_uint((ssl), SSL_VALUE_STREAM_WRITE_BUF_USED, \
        (value))
#define SSL_get_stream_write_buf_avail(ssl, value)                      \
    SSL_get_generic_value_uint((ssl), SSL_VALUE_STREAM_WRITE_BUF_AVAIL, \
        (value))

#define SSL_POLL_EVENT_NONE 0

#define SSL_POLL_EVENT_F (1U << 0) /* F   (Failure) */
#define SSL_POLL_EVENT_EL (1U << 1) /* EL  (Exception on Listener) */
#define SSL_POLL_EVENT_EC (1U << 2) /* EC  (Exception on Conn) */
#define SSL_POLL_EVENT_ECD (1U << 3) /* ECD (Exception on Conn Drained) */
#define SSL_POLL_EVENT_ER (1U << 4) /* ER  (Exception on Read) */
#define SSL_POLL_EVENT_EW (1U << 5) /* EW  (Exception on Write) */
#define SSL_POLL_EVENT_R (1U << 6) /* R   (Readable) */
#define SSL_POLL_EVENT_W (1U << 7) /* W   (Writable) */
#define SSL_POLL_EVENT_IC (1U << 8) /* IC  (Incoming Connection) */
#define SSL_POLL_EVENT_ISB (1U << 9) /* ISB (Incoming Stream: Bidi) */
#define SSL_POLL_EVENT_ISU (1U << 10) /* ISU (Incoming Stream: Uni) */
#define SSL_POLL_EVENT_OSB (1U << 11) /* OSB (Outgoing Stream: Bidi) */
#define SSL_POLL_EVENT_OSU (1U << 12) /* OSU (Outgoing Stream: Uni) */

#define SSL_POLL_EVENT_RW (SSL_POLL_EVENT_R | SSL_POLL_EVENT_W)
#define SSL_POLL_EVENT_RE (SSL_POLL_EVENT_R | SSL_POLL_EVENT_ER)
#define SSL_POLL_EVENT_WE (SSL_POLL_EVENT_W | SSL_POLL_EVENT_EW)
#define SSL_POLL_EVENT_RWE (SSL_POLL_EVENT_RE | SSL_POLL_EVENT_WE)
#define SSL_POLL_EVENT_E (SSL_POLL_EVENT_EL | SSL_POLL_EVENT_EC \
    | SSL_POLL_EVENT_ER | SSL_POLL_EVENT_EW)
#define SSL_POLL_EVENT_IS (SSL_POLL_EVENT_ISB | SSL_POLL_EVENT_ISU)
#define SSL_POLL_EVENT_ISE (SSL_POLL_EVENT_IS | SSL_POLL_EVENT_EC)
#define SSL_POLL_EVENT_I (SSL_POLL_EVENT_IS | SSL_POLL_EVENT_IC)
#define SSL_POLL_EVENT_OS (SSL_POLL_EVENT_OSB | SSL_POLL_EVENT_OSU)
#define SSL_POLL_EVENT_OSE (SSL_POLL_EVENT_OS | SSL_POLL_EVENT_EC)

/**
 * @brief One pollable resource and event masks for an SSL_poll() array entry.
 */
typedef struct ssl_poll_item_st {
    /**
     * @brief Pollable resource to query (typically an SSL via SSL_as_poll_descriptor()).
     */
    BIO_POLL_DESCRIPTOR desc;
    /**
     * @brief Bitmask of SSL_POLL_EVENT_* conditions the caller wants to observe.
     */
    uint64_t events;
    /**
     * @brief Bitmask of SSL_POLL_EVENT_* conditions that actually apply after SSL_poll().
     */
    uint64_t revents;
} SSL_POLL_ITEM;

#define SSL_POLL_FLAG_NO_HANDLE_EVENTS (1U << 0)

/**
 * @brief Poll readiness conditions for one or more SSL/BIO poll descriptors (e.g. QUIC).
 * @param items Array of SSL_POLL_ITEM entries to query or wait on.
 * @param num_items Number of entries in @p items.
 * @param stride Byte stride between consecutive items (usually sizeof(SSL_POLL_ITEM)).
 * @param timeout Maximum wait time, or NULL to wait indefinitely; zero timeval for non-blocking.
 * @param flags Bitmask of SSL_POLL_FLAG_* modifiers.
 * @param result_count Receives the number of items with a non-zero @c revents field.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_poll(SSL_POLL_ITEM *items,
    size_t num_items,
    size_t stride,
    const struct timeval *timeout,
    uint64_t flags,
    size_t *result_count);

/**
 * @brief Build a BIO_POLL_DESCRIPTOR that refers to SSL object @p s.
 * @param s SSL connection to poll (for example with SSL_handle_events / BIO_poll).
 * @return Descriptor with type BIO_POLL_DESCRIPTOR_TYPE_SSL and value.ssl set to @p s.
 */
static ossl_inline ossl_unused BIO_POLL_DESCRIPTOR
SSL_as_poll_descriptor(SSL *s)
{
    BIO_POLL_DESCRIPTOR d;

    d.type = BIO_POLL_DESCRIPTOR_TYPE_SSL;
    d.value.ssl = s;
    return d;
}

#ifndef OPENSSL_NO_DEPRECATED_1_1_0
#define SSL_cache_hit(s) SSL_session_reused(s)
#endif

/**
 * @brief Query whether the handshake reused an existing SSL session.
 * @param s SSL connection whose handshake result is inspected.
 * @return 1 if a session was reused, or 0 if a new session was negotiated.
 */
__owur int SSL_session_reused(const SSL *s);
/**
 * @brief Report whether an SSL object was created as a server endpoint.
 * @param s SSL connection to query.
 * @return 1 if @p s is a server, or 0 if it is a client.
 */
__owur int SSL_is_server(const SSL *s);

/**
 * @brief Allocate and initialise an SSL_CONF_CTX for SSL_CONF_* configuration commands.
 * @return Newly allocated SSL_CONF_CTX, or NULL on error.
 */
__owur __owur SSL_CONF_CTX *SSL_CONF_CTX_new(void);
/**
 * @brief Finalise configuration on an SSL_CONF_CTX after all SSL_CONF_cmd() calls.
 * @param cctx Configuration context to finish (applies defaults / deferred work).
 * @return 1 on success, or 0 on failure.
 */
int SSL_CONF_CTX_finish(SSL_CONF_CTX *cctx);
/**
 * @brief Free an SSL_CONF_CTX and any associated command state.
 * @param cctx Configuration context to free, or NULL.
 */
void SSL_CONF_CTX_free(SSL_CONF_CTX *cctx);
/**
 * @brief Set SSL_CONF_FLAG_* bits on a configuration context.
 * @param cctx Configuration context to update.
 * @param flags Bitmask of flags to set (OR'd into the existing flags).
 * @return The resulting flags value after setting.
 */
unsigned int SSL_CONF_CTX_set_flags(SSL_CONF_CTX *cctx, unsigned int flags);
/**
 * @brief Clear selected SSL_CONF_FLAG_* bits on a configuration context.
 * @param cctx Configuration context to update.
 * @param flags Bitmask of flags to clear.
 * @return The resulting flags value after clearing.
 */
__owur unsigned int SSL_CONF_CTX_clear_flags(SSL_CONF_CTX *cctx,
    unsigned int flags);
/**
 * @brief Set the command-name prefix recognised by subsequent SSL_CONF_cmd() calls.
 * @param cctx Configuration context to update.
 * @param pre Prefix string, or NULL to restore the default for the current flags.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CONF_CTX_set1_prefix(SSL_CONF_CTX *cctx, const char *pre);

/**
 * @brief Bind an SSL_CONF_CTX so subsequent SSL_CONF_cmd calls apply to @p ssl.
 * @param cctx Configuration context to update.
 * @param ssl SSL connection that receives configuration commands, or NULL to clear.
 */
void SSL_CONF_CTX_set_ssl(SSL_CONF_CTX *cctx, SSL *ssl);
/**
 * @brief Bind an SSL_CTX so subsequent SSL_CONF_cmd() calls configure that context.
 * @param cctx Configuration context to update.
 * @param ctx SSL context to receive commands, or NULL for syntax-check-only mode.
 */
void SSL_CONF_CTX_set_ssl_ctx(SSL_CONF_CTX *cctx, SSL_CTX *ctx);

/**
 * @brief Apply a configuration command (option plus optional value) to an SSL_CONF_CTX.
 * @param cctx Configuration context previously prepared with flags/prefix/target.
 * @param cmd Command or option name (prefix-sensitive; see SSL_CONF_cmd(3)).
 * @param value Optional value for @p cmd, or NULL when unused.
 * @return Positive on success (see man page for exact codes), 0 or negative on error.
 */
__owur int SSL_CONF_cmd(SSL_CONF_CTX *cctx, const char *cmd, const char *value);
__owur int SSL_CONF_cmd_argv(SSL_CONF_CTX *cctx, int *pargc, char ***pargv);
/**
 * @brief Return the value type expected by SSL_CONF_cmd() for a given command name.
 * @param cctx Configuration context whose flags/prefix affect command recognition.
 * @param cmd Command or option name (prefix-sensitive).
 * @return One of SSL_CONF_TYPE_* (UNKNOWN, STRING, FILE, DIR, or NONE).
 */
__owur int SSL_CONF_cmd_value_type(SSL_CONF_CTX *cctx, const char *cmd);

/**
 * @brief Historical no-op retained for compatibility; the SSL config module registers automatically.
 */
void SSL_add_ssl_module(void);
/**
 * @brief Apply a named configuration section from a previously loaded config file to an SSL.
 * @param s SSL connection to configure (CONF_modules_load_file or similar must already have run).
 * @param name Configuration section name (see config(5) / SSL_CONF).
 * @return 1 on success, or 0 on failure.
 */
int SSL_config(SSL *s, const char *name);
/**
 * @brief Apply a named configuration section from a previously loaded config file to an SSL_CTX.
 * @param ctx SSL context to configure (CONF_modules_load_file or similar must already have run).
 * @param name Configuration section name (see config(5) / SSL_CONF).
 * @return 1 on success, or 0 on failure.
 */
int SSL_CTX_config(SSL_CTX *ctx, const char *name);

#ifndef OPENSSL_NO_SSL_TRACE
/**
 * @brief Message-callback style tracer for SSL/TLS protocol records (for SSL_CTX_set_msg_callback).
 * @param write_p Non-zero when sending, or zero when receiving.
 * @param version Protocol version of the record (for example TLS1_2_VERSION).
 * @param content_type Record content type, or 0 for a header / incomplete record.
 * @param buf Protocol bytes being traced.
 * @param len Number of bytes at @p buf.
 * @param ssl SSL connection associated with the record.
 * @param arg Application argument from SSL_CTX_set_msg_callback_arg() (unused by this tracer).
 */
void SSL_trace(int write_p, int version, int content_type,
    const void *buf, size_t len, SSL *ssl, void *arg);
#endif

#ifndef OPENSSL_NO_SOCK
/**
 * @brief Statelessly listen for a new DTLS ClientHello and verify the cookie exchange.
 * @param s Newly allocated SSL with read/write BIOs set (typically an unconnected datagram BIO).
 * @param client Receives the peer address when a verified ClientHello is accepted.
 * @return >=1 when the handshake may continue (e.g. via SSL_accept), 0 to retry, or <0 on fatal error.
 */
int DTLSv1_listen(SSL *s, BIO_ADDR *client);
#endif

#ifndef OPENSSL_NO_CT

/**
 * @brief Callback that decides whether received SCTs satisfy Certificate Transparency policy.
 * @param ctx Policy evaluation context for the peer certificate chain.
 * @param scts Stack of signed certificate timestamps presented by the peer.
 * @param arg Application userdata registered with the validation callback.
 * @return 1 if SCTs are sufficient, 0 if insufficient (abort connection), or negative on error.
 */
typedef int (*ssl_ct_validation_cb)(const CT_POLICY_EVAL_CTX *ctx,
    const STACK_OF(SCT) *scts, void *arg);

/**
 * @brief Register a Certificate Transparency validation callback for an SSL connection.
 * Invoked after ServerHelloDone to validate received SCTs; a non-positive callback
 * result aborts the handshake. Setting a CT callback also requests an OCSP stapled response.
 * @param s SSL connection to configure; call before the handshake begins.
 * @param callback SCT policy callback, or NULL to disable CT validation.
 * @param arg Opaque userdata passed to @p callback on each invocation (caller retains ownership).
 * @return 1 on success, or 0 on failure (e.g. conflicting SCT custom extension).
 */
int SSL_set_ct_validation_callback(SSL *s, ssl_ct_validation_cb callback,
    void *arg);
/**
 * @brief Register a Certificate Transparency validation callback for an SSL context.
 * @param ctx SSL context whose connections inherit @p callback.
 * @param callback SCT policy callback, or NULL to disable CT validation.
 * @param arg Opaque userdata passed to @p callback on each invocation.
 * @return 1 on success, or 0 on failure (e.g. conflicting SCT custom extension).
 */
int SSL_CTX_set_ct_validation_callback(SSL_CTX *ctx,
    ssl_ct_validation_cb callback,
    void *arg);
#define SSL_disable_ct(s) \
    ((void)SSL_set_validation_callback((s), NULL, NULL))
#define SSL_CTX_disable_ct(ctx) \
    ((void)SSL_CTX_set_validation_callback((ctx), NULL, NULL))

/*
 * The validation type enumerates the available behaviours of the built-in SSL
 * CT validation callback selected via SSL_enable_ct() and SSL_CTX_enable_ct().
 * The underlying callback is a static function in libssl.
 */
/**
 * @brief Certificate Transparency validation policy for SSL_CTX_enable_ct().
 */
enum SSL_ct_validation_mode {
    /** Continue the handshake even if SCT validation fails; the application decides later. */
    SSL_CT_VALIDATION_PERMISSIVE = 0,
    /** Require at least one valid SCT or request handshake termination (unless SSL_VERIFY_NONE). */
    SSL_CT_VALIDATION_STRICT
};

/*
 * Enable CT by setting up a callback that implements one of the built-in
 * validation variants.  The SSL_CT_VALIDATION_PERMISSIVE variant always
 * continues the handshake, the application can make appropriate decisions at
 * handshake completion.  The SSL_CT_VALIDATION_STRICT variant requires at
 * least one valid SCT, or else handshake termination will be requested.  The
 * handshake may continue anyway if SSL_VERIFY_NONE is in effect.
 */
/**
 * @brief Enable Certificate Transparency validation on an SSL connection.
 * @param s SSL connection to configure.
 * @param validation_mode SSL_CT_VALIDATION_PERMISSIVE or SSL_CT_VALIDATION_STRICT.
 * @return 1 on success, or 0 on failure.
 */
int SSL_enable_ct(SSL *s, int validation_mode);
/**
 * @brief Enable Certificate Transparency validation on an SSL context (inherited by new connections).
 * @param ctx SSL context to configure.
 * @param validation_mode SSL_CT_VALIDATION_PERMISSIVE or SSL_CT_VALIDATION_STRICT.
 * @return 1 on success, or 0 on failure.
 */
int SSL_CTX_enable_ct(SSL_CTX *ctx, int validation_mode);

/*
 * Report whether a non-NULL callback is enabled.
 */
/**
 * @brief Report whether Certificate Transparency validation is enabled on an SSL connection.
 * @param s SSL connection to query.
 * @return 1 if a non-NULL CT validation callback is set (including via SSL_enable_ct), or 0 otherwise.
 */
int SSL_ct_is_enabled(const SSL *s);
/**
 * @brief Report whether Certificate Transparency validation is enabled on an SSL context.
 * @param ctx SSL context to query.
 * @return 1 if a non-NULL CT validation callback is set (including via SSL_CTX_enable_ct), or 0 otherwise.
 */
int SSL_CTX_ct_is_enabled(const SSL_CTX *ctx);

/**
 * @brief Return the signed certificate timestamps (SCTs) received on this connection.
 * @param s SSL connection to query.
 * @return Internal STACK_OF(SCT) of found SCTs (do not free), or NULL on error.
 */
const STACK_OF(SCT) *SSL_get0_peer_scts(SSL *s);

/*
 * Loads the CT log list from the default location.
 * If a CTLOG_STORE has previously been set using SSL_CTX_set_ctlog_store,
 * the log information loaded from this file will be appended to the
 * CTLOG_STORE.
 * Returns 1 on success, 0 otherwise.
 */
/**
 * @brief Load the default Certificate Transparency log list file into the context store.
 * @param ctx SSL context whose CT log store is populated or appended to.
 * @return 1 on success, or 0 on failure (the store may be partially updated).
 */
int SSL_CTX_set_default_ctlog_list_file(SSL_CTX *ctx);

/**
 * @brief Load a Certificate Transparency log list from a file and append it to the context store.
 * @param ctx SSL context whose CT log store is populated or appended to.
 * @param path Path to a CT log list file (see CTLOG_STORE_new for the format).
 * @return 1 on success, or 0 on failure (the store may be partially updated).
 */
int SSL_CTX_set_ctlog_list_file(SSL_CTX *ctx, const char *path);

/*
 * Sets the CT log list used by all SSL connections created from this SSL_CTX.
 * Ownership of the CTLOG_STORE is transferred to the SSL_CTX.
 */
/**
 * @brief Install a CT log store on an SSL context, transferring ownership of @p logs.
 * @param ctx SSL context whose CT log store is replaced.
 * @param logs CTLOG_STORE to use for SCT validation; owned by @p ctx after the call.
 */
void SSL_CTX_set0_ctlog_store(SSL_CTX *ctx, CTLOG_STORE *logs);

/*
 * Gets the CT log list used by all SSL connections created from this SSL_CTX.
 * This will be NULL unless one of the following functions has been called:
 * - SSL_CTX_set_default_ctlog_list_file
 * - SSL_CTX_set_ctlog_list_file
 * - SSL_CTX_set_ctlog_store
 */
/**
 * @brief Return the CT log store installed on an SSL context.
 * @param ctx SSL context to query.
 * @return Internal CTLOG_STORE pointer (do not free), or NULL if unset.
 */
const CTLOG_STORE *SSL_CTX_get0_ctlog_store(const SSL_CTX *ctx);

#endif /* OPENSSL_NO_CT */

/* What the "other" parameter contains in security callback */
/* Mask for type */
#define SSL_SECOP_OTHER_TYPE 0xffff0000
#define SSL_SECOP_OTHER_NONE 0
#define SSL_SECOP_OTHER_CIPHER (1 << 16)
#define SSL_SECOP_OTHER_CURVE (2 << 16)
#define SSL_SECOP_OTHER_DH (3 << 16)
#define SSL_SECOP_OTHER_PKEY (4 << 16)
#define SSL_SECOP_OTHER_SIGALG (5 << 16)
#define SSL_SECOP_OTHER_CERT (6 << 16)

/* Indicated operation refers to peer key or certificate */
#define SSL_SECOP_PEER 0x1000

/* Values for "op" parameter in security callback */

/* Called to filter ciphers */
/* Ciphers client supports */
#define SSL_SECOP_CIPHER_SUPPORTED (1 | SSL_SECOP_OTHER_CIPHER)
/* Cipher shared by client/server */
#define SSL_SECOP_CIPHER_SHARED (2 | SSL_SECOP_OTHER_CIPHER)
/* Sanity check of cipher server selects */
#define SSL_SECOP_CIPHER_CHECK (3 | SSL_SECOP_OTHER_CIPHER)
/* Curves supported by client */
#define SSL_SECOP_CURVE_SUPPORTED (4 | SSL_SECOP_OTHER_CURVE)
/* Curves shared by client/server */
#define SSL_SECOP_CURVE_SHARED (5 | SSL_SECOP_OTHER_CURVE)
/* Sanity check of curve server selects */
#define SSL_SECOP_CURVE_CHECK (6 | SSL_SECOP_OTHER_CURVE)
/* Temporary DH key */
#define SSL_SECOP_TMP_DH (7 | SSL_SECOP_OTHER_PKEY)
/* SSL/TLS version */
#define SSL_SECOP_VERSION (9 | SSL_SECOP_OTHER_NONE)
/* Session tickets */
#define SSL_SECOP_TICKET (10 | SSL_SECOP_OTHER_NONE)
/* Supported signature algorithms sent to peer */
#define SSL_SECOP_SIGALG_SUPPORTED (11 | SSL_SECOP_OTHER_SIGALG)
/* Shared signature algorithm */
#define SSL_SECOP_SIGALG_SHARED (12 | SSL_SECOP_OTHER_SIGALG)
/* Sanity check signature algorithm allowed */
#define SSL_SECOP_SIGALG_CHECK (13 | SSL_SECOP_OTHER_SIGALG)
/* Used to get mask of supported public key signature algorithms */
#define SSL_SECOP_SIGALG_MASK (14 | SSL_SECOP_OTHER_SIGALG)
/* Use to see if compression is allowed */
#define SSL_SECOP_COMPRESSION (15 | SSL_SECOP_OTHER_NONE)
/* EE key in certificate */
#define SSL_SECOP_EE_KEY (16 | SSL_SECOP_OTHER_CERT)
/* CA key in certificate */
#define SSL_SECOP_CA_KEY (17 | SSL_SECOP_OTHER_CERT)
/* CA digest algorithm in certificate */
#define SSL_SECOP_CA_MD (18 | SSL_SECOP_OTHER_CERT)
/* Peer EE key in certificate */
#define SSL_SECOP_PEER_EE_KEY (SSL_SECOP_EE_KEY | SSL_SECOP_PEER)
/* Peer CA key in certificate */
#define SSL_SECOP_PEER_CA_KEY (SSL_SECOP_CA_KEY | SSL_SECOP_PEER)
/* Peer CA digest algorithm in certificate */
#define SSL_SECOP_PEER_CA_MD (SSL_SECOP_CA_MD | SSL_SECOP_PEER)

/**
 * @brief Set the security level used to constrain algorithms and parameters on a connection.
 * @param s SSL connection whose security level is updated.
 * @param level Security level (typically 0–5); see SSL_CTX_set_security_level(3).
 */
void SSL_set_security_level(SSL *s, int level);
/**
 * @brief Return the security level that constrains algorithms on a connection.
 * @param s SSL connection to query.
 * @return Security level (typically 0–5); see SSL_CTX_set_security_level(3).
 */
__owur int SSL_get_security_level(const SSL *s);
/**
 * @brief Install a callback that filters crypto choices according to security policy.
 * @param s SSL connection that will invoke @p cb during handshakes and related checks.
 * @param cb Security callback, or NULL to restore the default; see SSL_CTX_set_security_level(3).
 */
void SSL_set_security_callback(SSL *s,
    int (*cb)(const SSL *s, const SSL_CTX *ctx,
        int op, int bits, int nid,
        void *other, void *ex));
/**
 * @brief Return the security callback currently installed on a connection.
 * @param s SSL connection to query.
 * @return Function pointer for the callback, or the default if none was set explicitly.
 */
int (*SSL_get_security_callback(const SSL *s))(const SSL *s,
    const SSL_CTX *ctx, int op,
    int bits, int nid, void *other,
    void *ex);
/**
 * @brief Set the application pointer passed as @c ex to the connection security callback.
 * @param s SSL connection whose security callback receives @p ex.
 * @param ex Application-specific value forwarded verbatim to the callback.
 */
void SSL_set0_security_ex_data(SSL *s, void *ex);
/**
 * @brief Return the application pointer passed as @c ex to the connection security callback.
 * @param s SSL connection whose security callback userdata is queried.
 * @return Pointer previously set with SSL_set0_security_ex_data(), or NULL.
 */
__owur void *SSL_get0_security_ex_data(const SSL *s);

/**
 * @brief Set the security level used to constrain algorithms and parameters on an SSL context.
 * @param ctx SSL context whose new connections inherit @p level.
 * @param level Security level (typically 0–5); see SSL_CTX_set_security_level(3).
 */
void SSL_CTX_set_security_level(SSL_CTX *ctx, int level);
/**
 * @brief Return the security level currently configured on an SSL context.
 * @param ctx SSL context to query.
 * @return Current security level value.
 */
__owur int SSL_CTX_get_security_level(const SSL_CTX *ctx);
/**
 * @brief Install a security-policy callback used by connections created from a context.
 * @param ctx SSL context whose connections inherit @p cb.
 * @param cb Security callback, or NULL to restore the default; see SSL_CTX_set_security_level(3).
 */
void SSL_CTX_set_security_callback(SSL_CTX *ctx,
    int (*cb)(const SSL *s, const SSL_CTX *ctx,
        int op, int bits, int nid,
        void *other, void *ex));
/**
 * @brief Return the security callback currently installed on an SSL context.
 * @param ctx SSL context to query.
 * @return Function pointer for the callback, or the default if none was set explicitly.
 */
int (*SSL_CTX_get_security_callback(const SSL_CTX *ctx))(const SSL *s,
    const SSL_CTX *ctx,
    int op, int bits,
    int nid,
    void *other,
    void *ex);
/**
 * @brief Set the application pointer passed as @c ex to the context security callback.
 * @param ctx SSL context whose security callback receives @p ex.
 * @param ex Application-specific value forwarded verbatim to the callback.
 */
void SSL_CTX_set0_security_ex_data(SSL_CTX *ctx, void *ex);
/**
 * @brief Return the application pointer passed as @c ex to the context security callback.
 * @param ctx SSL context to query.
 * @return Extra data previously set with SSL_CTX_set0_security_ex_data, or NULL if unset.
 */
__owur void *SSL_CTX_get0_security_ex_data(const SSL_CTX *ctx);

/* OPENSSL_INIT flag 0x010000 reserved for internal use */
#define OPENSSL_INIT_NO_LOAD_SSL_STRINGS 0x00100000L
#define OPENSSL_INIT_LOAD_SSL_STRINGS 0x00200000L

#define OPENSSL_INIT_SSL_DEFAULT \
    (OPENSSL_INIT_LOAD_SSL_STRINGS | OPENSSL_INIT_LOAD_CRYPTO_STRINGS)

/**
 * @brief Explicitly initialise libssl and libcrypto with the given options and settings.
 * @param opts Bitwise OR of OPENSSL_INIT_* flags (libcrypto options plus OPENSSL_INIT_LOAD_SSL_STRINGS / OPENSSL_INIT_NO_LOAD_SSL_STRINGS).
 * @param settings Optional init settings (see OPENSSL_init_crypto), or NULL.
 * @return 1 on success, or 0 on error.
 *
 * Automatic init usually makes this unnecessary; call it before other OpenSSL APIs when non-default initialisation is required.
 */
int OPENSSL_init_ssl(uint64_t opts, const OPENSSL_INIT_SETTINGS *settings);

#ifndef OPENSSL_NO_UNIT_TEST
__owur const struct openssl_ssl_test_functions *SSL_test_functions(void);
#endif

/**
 * @brief Free the read and write record buffers associated with an SSL connection.
 * @param ssl SSL connection whose buffers should be released (no-op / fails for QUIC).
 * @return 1 if buffers are free (or were already free), or 0 if pending data prevents freeing.
 */
__owur int SSL_free_buffers(SSL *ssl);
/**
 * @brief Allocate (or keep) the read and write record buffers for an SSL connection.
 * @param ssl SSL connection whose buffers should be preallocated (always succeeds for QUIC).
 * @return 1 if the buffers are allocated (or were already allocated), or 0 on allocation failure.
 *
 * Useful with SSL_MODE_RELEASE_BUFFERS to preallocate after SSL_free_buffers(), or with
 * custom CRYPTO_set_mem_functions() allocators. Automatic reallocation on I/O still occurs
 * if buffers were freed.
 */
__owur int SSL_alloc_buffers(SSL *ssl);

/* Status codes passed to the decrypt session ticket callback. Some of these
 * are for internal use only and are never passed to the callback. */
/**
 * @brief Status code describing the outcome of session-ticket decryption for the ticket callback.
 */
typedef int SSL_TICKET_STATUS;

/* Support for ticket appdata */
/* fatal error, malloc failure */
#define SSL_TICKET_FATAL_ERR_MALLOC 0
/* fatal error, either from parsing or decrypting the ticket */
#define SSL_TICKET_FATAL_ERR_OTHER 1
/* No ticket present */
#define SSL_TICKET_NONE 2
/* Empty ticket present */
#define SSL_TICKET_EMPTY 3
/* the ticket couldn't be decrypted */
#define SSL_TICKET_NO_DECRYPT 4
/* a ticket was successfully decrypted */
#define SSL_TICKET_SUCCESS 5
/* same as above but the ticket needs to be renewed */
#define SSL_TICKET_SUCCESS_RENEW 6

/* Return codes for the decrypt session ticket callback */
/**
 * @brief Return code from the decrypt-session-ticket callback controlling ticket use and renewal.
 */
typedef int SSL_TICKET_RETURN;

/* An error occurred */
#define SSL_TICKET_RETURN_ABORT 0
/* Do not use the ticket, do not send a renewed ticket to the client */
#define SSL_TICKET_RETURN_IGNORE 1
/* Do not use the ticket, send a renewed ticket to the client */
#define SSL_TICKET_RETURN_IGNORE_RENEW 2
/* Use the ticket, do not send a renewed ticket to the client */
#define SSL_TICKET_RETURN_USE 3
/* Use the ticket, send a renewed ticket to the client */
#define SSL_TICKET_RETURN_USE_RENEW 4

/**
 * @brief Callback invoked just before a server creates a session ticket (set ticket appdata here).
 * @param s SSL connection for which a ticket is about to be issued.
 * @param arg Userdata from SSL_CTX_set_session_ticket_cb().
 * @return Application-defined status; non-zero continues ticket creation.
 */
typedef int (*SSL_CTX_generate_session_ticket_fn)(SSL *s, void *arg);
/**
 * @brief Application callback that decrypts/validates a received session ticket.
 * @param s SSL connection that received the ticket.
 * @param ss Session object to populate or reject.
 * @param keyname Ticket key name from the ticket header.
 * @param keyname_length Length of @p keyname in bytes.
 * @param status Preliminary ticket parse status (SSL_TICKET_*), before app decrypt.
 * @param arg Application pointer supplied to SSL_CTX_set_session_ticket_cb().
 * @return SSL_TICKET_RETURN_* instructing OpenSSL how to proceed.
 */
typedef SSL_TICKET_RETURN (*SSL_CTX_decrypt_session_ticket_fn)(SSL *s, SSL_SESSION *ss,
    const unsigned char *keyname,
    size_t keyname_length,
    SSL_TICKET_STATUS status,
    void *arg);
/**
 * @brief Register callbacks that attach and consume application data in TLS session tickets.
 * @param ctx Server SSL context that will invoke the ticket callbacks.
 * @param gen_cb Called before ticket creation (may call SSL_SESSION_set1_ticket_appdata), or NULL.
 * @param dec_cb Called after ticket decryption with @c status and optional appdata, or NULL.
 * @param arg Opaque userdata passed to both callbacks.
 * @return 1 on success, or 0 on failure.
 */
int SSL_CTX_set_session_ticket_cb(SSL_CTX *ctx,
    SSL_CTX_generate_session_ticket_fn gen_cb,
    SSL_CTX_decrypt_session_ticket_fn dec_cb,
    void *arg);
/**
 * @brief Attach application data that will be stored inside a TLS session ticket.
 * @param ss Session that will be serialized into a ticket (typically from the generate-ticket callback).
 * @param data Application bytes to copy into the ticket, or NULL to clear.
 * @param len Number of bytes at @p data; ignored when @p data is NULL.
 * @return 1 on success, or 0 on failure.
 */
int SSL_SESSION_set1_ticket_appdata(SSL_SESSION *ss, const void *data, size_t len);
/**
 * @brief Retrieve application data previously stored with a session ticket.
 * @param ss Session whose ticket appdata is queried.
 * @param data Set to the appdata bytes (not to be freed), or NULL if none.
 * @param len Set to the length of @p *data in bytes, or 0 if none.
 * @return 1 on success, or 0 on failure.
 */
int SSL_SESSION_get0_ticket_appdata(SSL_SESSION *ss, void **data, size_t *len);

/**
 * @brief Callback that chooses the next DTLS retransmission timeout in microseconds.
 * @param s DTLS SSL connection about to send a packet.
 * @param timer_us Previously returned timeout in microseconds, or 0 on the first call.
 * @return Timeout interval in microseconds until the next DTLS timer expiry.
 */
typedef unsigned int (*DTLS_timer_cb)(SSL *s, unsigned int timer_us);

/**
 * @brief Set a callback that controls DTLS retransmission timer duration.
 * @param s DTLS SSL connection whose timer callback is set.
 * @param cb Callback invoked for each new DTLS packet; NULL restores the default doubling schedule.
 */
void DTLS_set_timer_cb(SSL *s, DTLS_timer_cb cb);

/**
 * @brief Server callback that decides whether to accept TLSv1.3 early data for a connection.
 * @param s Server SSL connection that received early data / a 0-RTT ClientHello.
 * @param arg Application pointer from SSL_CTX_set_allow_early_data_cb() / SSL_set_allow_early_data_cb().
 * @return 1 to allow early data, or 0 to reject it.
 */
typedef int (*SSL_allow_early_data_cb_fn)(SSL *s, void *arg);
/**
 * @brief Set a server callback that decides whether to accept TLSv1.3 early data for a context.
 * @param ctx Server SSL context whose early-data decision callback is set (copied to new SSL objects).
 * @param cb Callback returning 1 to allow early data or 0 to reject it; NULL clears the callback.
 * @param arg Opaque pointer passed to @p cb on each invocation.
 */
void SSL_CTX_set_allow_early_data_cb(SSL_CTX *ctx,
    SSL_allow_early_data_cb_fn cb,
    void *arg);
/**
 * @brief Set a server callback that decides whether to accept TLSv1.3 early data on a connection.
 * @param s Server SSL connection whose early-data decision callback is set (not for QUIC).
 * @param cb Callback returning 1 to allow early data or 0 to reject it; NULL clears the callback.
 * @param arg Opaque pointer passed to @p cb on each invocation.
 */
void SSL_set_allow_early_data_cb(SSL *s,
    SSL_allow_early_data_cb_fn cb,
    void *arg);

/* store the default cipher strings inside the library */
/**
 * @brief Return the built-in default TLSv1.2 (and earlier) cipher-list string.
 * @return NUL-terminated cipher list used when no explicit list is configured.
 */
const char *OSSL_default_cipher_list(void);
/**
 * @brief Return the built-in default TLSv1.3 ciphersuite list string.
 * @return NUL-terminated ciphersuite list used when no explicit list is configured.
 */
const char *OSSL_default_ciphersuites(void);

/* RFC8879 Certificate compression APIs */

/**
 * @brief Pre-compress all certificates configured on a server SSL_CTX with algorithm @p alg.
 * @param ctx Server SSL context whose certificates are compressed.
 * @param alg Compression algorithm identifier, or 0 to use each algorithm in the preference list.
 * @return 1 on success, or 0 on failure (including when @p ctx is a client context).
 */
int SSL_CTX_compress_certs(SSL_CTX *ctx, int alg);
/**
 * @brief Pre-compress all certificates configured on a server SSL connection with algorithm @p alg.
 * @param ssl Server SSL connection whose certificates are compressed.
 * @param alg Compression algorithm identifier (for example TLSEXT_comp_cert_zlib), or 0 to use each algorithm in the preference list.
 * @return 1 on success, or 0 on failure (including when @p ssl is a client connection).
 */
int SSL_compress_certs(SSL *ssl, int alg);

/**
 * @brief Set the preferred TLSv1.3 certificate compression algorithms for an SSL context (RFC 8879).
 * @param ctx SSL context whose preference list is replaced.
 * @param algs Array of TLSEXT_comp_cert_* algorithm identifiers in preference order.
 * @param len Size of @p algs in bytes (not element count).
 * @return 1 on success, or 0 on failure (preference list left unchanged on error).
 */
int SSL_CTX_set1_cert_comp_preference(SSL_CTX *ctx, int *algs, size_t len);
/**
 * @brief Set the preferred certificate-compression algorithms for an SSL connection.
 * @param ssl SSL connection to configure.
 * @param algs Array of TLSEXT_comp_cert_* algorithm identifiers in preference order.
 * @param len Number of entries in @p algs.
 * @return 1 on success, or 0 on failure.
 */
int SSL_set1_cert_comp_preference(SSL *ssl, int *algs, size_t len);

/**
 * @brief Install a pre-compressed certificate blob on a server SSL context.
 * @param ctx Server SSL context that will send the compressed certificate.
 * @param algorithm Certificate compression algorithm identifier.
 * @param comp_data Compressed certificate bytes (copied into @p ctx).
 * @param comp_length Length of @p comp_data in bytes.
 * @param orig_length Uncompressed certificate length in bytes.
 * @return 1 on success, or 0 on failure (including when @p ctx is a client context).
 */
int SSL_CTX_set1_compressed_cert(SSL_CTX *ctx, int algorithm, unsigned char *comp_data,
    size_t comp_length, size_t orig_length);
/**
 * @brief Install a pre-compressed certificate blob on a server SSL connection.
 * @param ssl Server SSL connection that will send the compressed certificate.
 * @param algorithm Certificate compression algorithm identifier.
 * @param comp_data Compressed certificate bytes (copied into @p ssl).
 * @param comp_length Length of @p comp_data in bytes.
 * @param orig_length Uncompressed certificate length in bytes.
 * @return 1 on success, or 0 on failure (including when @p ssl is a client connection).
 */
int SSL_set1_compressed_cert(SSL *ssl, int algorithm, unsigned char *comp_data,
    size_t comp_length, size_t orig_length);
/**
 * @brief Get a copy of a compressed certificate configured on an SSL_CTX.
 * @param ctx SSL context that may hold compressed certificates.
 * @param alg Compression algorithm identifier (TLSEXT_comp_cert_*).
 * @param data Receives a newly allocated compressed certificate buffer (caller frees with OPENSSL_free).
 * @param orig_len Receives the uncompressed certificate length in bytes.
 * @return Length of *@p data in bytes, or 0 if unavailable / on error.
 */
size_t SSL_CTX_get1_compressed_cert(SSL_CTX *ctx, int alg, unsigned char **data, size_t *orig_len);
/**
 * @brief Copy the pre-compressed certificate stored for algorithm @p alg on a server SSL connection.
 * @param ssl Server SSL connection that holds a pre-compressed certificate.
 * @param alg Compression algorithm identifier matching a stored blob.
 * @param data On success, set to a newly allocated compressed certificate (caller frees with OPENSSL_free).
 * @param orig_len On success, set to the uncompressed certificate length in bytes.
 * @return Length of @p *data in bytes on success, or 0 on failure (including client connections).
 */
size_t SSL_get1_compressed_cert(SSL *ssl, int alg, unsigned char **data, size_t *orig_len);

/**
 * @brief Add a DANE TLSA record matching raw public key @p rpk to the connection's validation policy.
 * @param s SSL connection with DANE enabled (or to be enabled) that will trust @p rpk.
 * @param rpk Expected peer raw public key; may be called multiple times for key rotation.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_add_expected_rpk(SSL *s, EVP_PKEY *rpk);
/**
 * @brief Return the peer's negotiated raw public key (RFC 7250), if any.
 * @param s SSL connection after the peer authentication material is available.
 * @return Peer EVP_PKEY for the raw public key, or NULL if none; do not free (owned by @p s).
 */
__owur EVP_PKEY *SSL_get0_peer_rpk(const SSL *s);
/**
 * @brief Return the peer's raw public key (RFC 7250) stored on an SSL session, if any.
 * @param s Session that may hold a negotiated peer raw public key.
 * @return Peer EVP_PKEY for the raw public key, or NULL if none; do not free (owned by @p s).
 */
__owur EVP_PKEY *SSL_SESSION_get0_peer_rpk(SSL_SESSION *s);
/**
 * @brief Return the negotiated client certificate type for a connection (RFC 7250).
 * @param s SSL connection after the ServerHello / certificate-type negotiation.
 * @return TLSEXT_cert_type_x509 or TLSEXT_cert_type_rpk.
 */
__owur int SSL_get_negotiated_client_cert_type(const SSL *s);
/**
 * @brief Return the negotiated server certificate type for a connection (RFC 7250).
 * @param s SSL connection after the ServerHello / certificate-type negotiation.
 * @return TLSEXT_cert_type_x509 or TLSEXT_cert_type_rpk.
 */
__owur int SSL_get_negotiated_server_cert_type(const SSL *s);

/**
 * @brief Set the client certificate type extension values for an SSL connection (RFC 7250).
 * @param s SSL connection that will send or accept the listed client certificate types.
 * @param val Preference-ordered array of TLSEXT_cert_type_* values, or NULL with @p len 0 to disable the extension.
 * @param len Number of bytes in @p val.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set1_client_cert_type(SSL *s, const unsigned char *val, size_t len);
/**
 * @brief Set the list of server certificate types this connection is willing to use.
 * @param s SSL connection to configure.
 * @param val Array of certificate type bytes (for example TLSEXT_cert_type_* values).
 * @param len Number of bytes in @p val.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_set1_server_cert_type(SSL *s, const unsigned char *val, size_t len);
/**
 * @brief Set the client certificate type extension values for an SSL context (RFC 7250).
 * @param ctx SSL context whose default client certificate types are set (copied to new SSL objects).
 * @param val Preference-ordered array of TLSEXT_cert_type_* values, or NULL with @p len 0 to disable the extension.
 * @param len Number of bytes in @p val.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set1_client_cert_type(SSL_CTX *ctx, const unsigned char *val, size_t len);
/**
 * @brief Set the server certificate type values advertised by an SSL_CTX (RFC 7250).
 * @param ctx SSL context to configure.
 * @param val Buffer of certificate type bytes (for example TLSEXT_cert_type_*).
 * @param len Number of bytes at @p val.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_set1_server_cert_type(SSL_CTX *ctx, const unsigned char *val, size_t len);
/**
 * @brief Retrieve the local client certificate type extension values configured on an SSL connection.
 * @param s SSL connection to query.
 * @param t Set to the internal preference-ordered type bytes (not to be freed).
 * @param len Set to the length of @p *t in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_get0_client_cert_type(const SSL *s, unsigned char **t, size_t *len);
/**
 * @brief Retrieve the local server certificate type extension values configured on an SSL connection.
 * @param s SSL connection to query.
 * @param t Set to the internal preference-ordered type bytes (not to be freed).
 * @param len Set to the length of @p *t in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_get0_server_cert_type(const SSL *s, unsigned char **t, size_t *len);
/**
 * @brief Retrieve the local client certificate type extension values configured on an SSL context.
 * @param ctx SSL context to query.
 * @param t Set to the internal preference-ordered type bytes (not to be freed).
 * @param len Set to the length of @p *t in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_get0_client_cert_type(const SSL_CTX *ctx, unsigned char **t, size_t *len);
/**
 * @brief Retrieve the local server certificate type extension values configured on an SSL context.
 * @param s SSL context to query.
 * @param t Set to the internal preference-ordered type bytes (not to be freed).
 * @param len Set to the length of @p *t in bytes.
 * @return 1 on success, or 0 on failure.
 */
__owur int SSL_CTX_get0_server_cert_type(const SSL_CTX *s, unsigned char **t, size_t *len);

#ifdef __cplusplus
}
#endif
#endif
