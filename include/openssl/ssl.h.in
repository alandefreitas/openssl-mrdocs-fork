 * @brief Return an SSL_METHOD that negotiates the highest mutually supported TLS version.
 * @return Pointer to the flexible TLS client/server method for SSL_CTX_new().
 */
__owur const SSL_METHOD *TLS_method(void);
/**
 * @brief Return a server-only SSL_METHOD that negotiates the highest mutually supported TLS version.
 * @return Pointer to the static TLS server SSL_METHOD for use with SSL_CTX_new.
 */
__owur const SSL_METHOD *TLS_server_method(void);
/**
 * @brief Return a client-only SSL_METHOD that negotiates the highest mutually supported TLS version.
 * @return Pointer to the static TLS client SSL_METHOD for use with SSL_CTX_new.
 */
__owur const SSL_METHOD *TLS_client_method(void);

